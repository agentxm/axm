<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>AgentXM.Examples.TinyFlags.FSharp</PackageId>
    <Version>0.2.0</Version>
    <Description>Tiny feature flags library used by AXM companion package examples.</Description>
    <PackageTags>agentxm;axm;feature-flags;example;fsharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TinyFlags.fs" />
    <None Include="../../axm.json" Pack="true" PackagePath="axm.json" />
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
