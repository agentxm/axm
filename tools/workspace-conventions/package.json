{
  "name": "@agentxm/workspace-conventions",
  "version": "0.51.0",
  "description": "Engineering conventions for Nx and pnpm TypeScript workspaces: an ESLint flat-config preset that enforces capability boundaries and a staged commit gate for Git pre-commit hooks. Engineering support, not part of the runtime. Unstable and unsupported.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "homepage": "https://axm.sh",
  "bugs": {
    "url": "https://github.com/agentxm/axm/issues"
  },
  "author": "AgentXM <hello@agentxm.ai> (https://agentxm.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm.git",
    "directory": "tools/workspace-conventions"
  },
  "sideEffects": false,
  "exports": {
    "./capability-boundaries": "./src/capability-boundaries.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "!src/**/*.test.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "nx": {
    "includedScripts": []
  },
  "peerDependencies": {
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "lint-staged": "^17.5.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "lint-staged": "catalog:",
    "nx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
