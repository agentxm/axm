{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "outDir": "dist",
    "rootDir": ".",
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "globalConsole": "off",
          "nodeBuiltinImport": "off"
        }
      }
    ]
  },
  "include": ["src/**/*.test.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "references": [{ "path": "./tsconfig.lib.json" }]
}
