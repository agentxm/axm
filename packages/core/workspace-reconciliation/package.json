  "dependencies": {
    "@agentxm/agent-integration": "workspace:^",
    "@agentxm/extension-materialization": "workspace:^",
    "@agentxm/extension-model": "workspace:^",
    "@agentxm/extension-resolution": "workspace:^",
    "@agentxm/extension-sources": "workspace:^",
    "@agentxm/workspace-operations": "workspace:^",
    "@agentxm/workspace-projection": "workspace:^",
    "@agentxm/workspace-state": "workspace:^",
    "@agentxm/workspace-transactions": "workspace:^",
    "effect": "catalog:",
    "semver": "catalog:",
    "@agentxm/registry-client": "workspace:^"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/semver": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
