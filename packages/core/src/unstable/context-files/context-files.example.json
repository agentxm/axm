{
  "$schema": "https://axm.sh/schemas/context-files.schema.json",
  "owner": "@acme",
  "type": "file",
  "name": "workspace-baseline",
  "version": "1.0.0",
  "description": "Shared workspace baseline files",
  "inputs": {
    "projectName": {
      "type": "string",
      "prompt": "Project name"
    }
  },
  "contents": [
    {
      "source": {
        "kind": "template",
        "path": "README.md"
      },
      "target": "README.md",
      "mode": "sync-once"
    },
    {
      "source": {
        "kind": "generated",
        "generator": {
          "name": "file-index",
          "options": {
            "format": "tree"
          }
        }
      },
      "target": "README.md",
      "mode": "managed-region",
      "region": "workspace-index"
    }
  ]
}
