{
  "name": "@agentxm/extension-kinds",
  "version": "0.0.1",
  "description": "AXM extension kinds: skill, subagent, MCP connection, hook, instruction, Knowledge, and pack managers, plans, and errors for the axm CLI. Unstable and unsupported \u2014 use the axm.sh CLI.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "homepage": "https://axm.sh",
  "bugs": {
    "url": "https://github.com/agentxm/axm/issues"
  },
  "author": "AgentXM <hello@agentxm.ai> (https://agentxm.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm.git",
    "directory": "packages/core/extension-kinds"
  },
  "sideEffects": false,
  "exports": {
    "./skills": {
      "types": "./dist/src/skills/index.d.ts",
      "axm-source": "./src/skills/index.ts",
      "default": "./dist/src/skills/index.js"
    },
    "./subagents": {
      "types": "./dist/src/subagents/index.d.ts",
      "axm-source": "./src/subagents/index.ts",
      "default": "./dist/src/subagents/index.js"
    },
    "./mcp-connections": {
      "types": "./dist/src/mcp-connections/index.d.ts",
      "axm-source": "./src/mcp-connections/index.ts",
      "default": "./dist/src/mcp-connections/index.js"
    },
    "./hooks": {
      "types": "./dist/src/hooks/index.d.ts",
      "axm-source": "./src/hooks/index.ts",
      "default": "./dist/src/hooks/index.js"
    },
    "./instructions": {
      "types": "./dist/src/instructions/index.d.ts",
      "axm-source": "./src/instructions/index.ts",
      "default": "./dist/src/instructions/index.js"
    },
    "./knowledge": {
      "types": "./dist/src/knowledge/index.d.ts",
      "axm-source": "./src/knowledge/index.ts",
      "default": "./dist/src/knowledge/index.js"
    },
    "./packs": {
      "types": "./dist/src/packs/index.d.ts",
      "axm-source": "./src/packs/index.ts",
      "default": "./dist/src/packs/index.js"
    },
    "./live": {
      "types": "./dist/src/live.d.ts",
      "axm-source": "./src/live.ts",
      "default": "./dist/src/live.js"
    }
  },
  "files": [
    "dist/src/",
    "!**/*.map"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {
    "@agentxm/cli-maintenance": "workspace:^",
    "@agentxm/extension-content": "workspace:^",
    "@agentxm/extension-model": "workspace:^",
    "@agentxm/host-primitives": "workspace:^",
    "@agentxm/registry-client": "workspace:^",
    "@agentxm/workspace-kernel": "workspace:^",
    "@napi-rs/keyring": "^1.3.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@fast-check/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true
}
