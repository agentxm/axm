{
  "name": "@agentxm/extension-resolution",
  "version": "0.28.13",
  "description": "AXM extension resolution policy: what a configured or requested extension resolves to and whether that resolution may be accepted — release-age policy, version selection, configured-entry and Pack dependency resolution, workspace source authority, publisher-binding trust, and official AXM skill compatibility. Unstable and unsupported — use the axm.sh CLI.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "homepage": "https://axm.sh",
  "bugs": {
    "url": "https://github.com/agentxm/axm/issues"
  },
  "author": "AgentXM <hello@agentxm.ai> (https://agentxm.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm.git",
    "directory": "packages/core/extension-resolution"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "axm-source": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./live": {
      "types": "./dist/src/live.d.ts",
      "axm-source": "./src/live.ts",
      "default": "./dist/src/live.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "axm-source": "./src/testing.ts",
      "default": "./dist/src/testing.js"
    }
  },
  "files": [
    "dist/src/",
    "!**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {
    "@agentxm/extension-content": "workspace:^",
    "@agentxm/extension-model": "workspace:^",
    "@agentxm/extension-sources": "workspace:^",
    "@agentxm/registry-protocol": "workspace:^",
    "@agentxm/workspace-state": "workspace:^",
    "effect": "catalog:",
    "semver": "catalog:"
  },
  "devDependencies": {
    "@agentxm/specification-metadata": "workspace:^",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/semver": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
