{
  "$schema": "https://axm.sh/schemas/mcp.schema.json",
  "owner": "@acme",
  "type": "mcp-server",
  "name": "database-mcp",
  "version": "1.0.0",
  "description": "MCP server for database operations",
  "keywords": ["mcp", "database", "sql"],
  "license": "Apache-2.0",
  "packages": [{ "purl": "pkg:npm/%40acme/database-toolkit", "versionRange": "vers:npm/>=2.0.0" }],
  "server": {
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.acme/database-mcp",
    "description": "MCP server for database operations",
    "version": "1.0.0",
    "packages": [
      {
        "registryType": "npm",
        "identifier": "@acme/database-mcp",
        "version": "1.0.0",
        "runtimeHint": "npx",
        "transport": { "type": "stdio" },
        "environmentVariables": [
          {
            "name": "DATABASE_URL",
            "isRequired": true,
            "isSecret": true
          }
        ]
      }
    ],
    "remotes": [
      {
        "type": "streamable-http",
        "url": "https://mcp.acme.com/database"
      }
    ]
  }
}
