{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "parallel": 2,
  "maxCacheSize": "2GB",
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": false,
        "build": false
      }
    },
    "./scripts/typecheck-plugin.ts",
    "./scripts/placement-tags-plugin.ts",
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "include": [
        "apps/cli/vitest.config.ts",
        "packages/**/vitest.config.ts",
        "tools/**/vitest.config.ts",
        "specifications/vitest.config.ts"
      ],
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    },
    {
      "plugin": "@nx/vitest",
      "include": ["apps/cli-e2e/vitest.config.ts"],
      "options": {
        "testTargetName": "e2e-main",
        "testMode": "run"
      }
    }
  ],
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig*.json",
      "{workspaceRoot}/vitest.execution.ts",
      "{workspaceRoot}/vitest.reporting.ts",
      "{workspaceRoot}/scripts/specification-evidence*.ts",
      "{workspaceRoot}/scripts/placement-tags-plugin.ts"
    ],
    "hostPlatform": [
      {
        "runtime": "node -p \"process.platform + '/' + process.arch\""
      }
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/scripts/**",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.e2e.test.ts",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.type-test.ts",
      "!{projectRoot}/vitest*.config.ts",
      "!{projectRoot}/**/*.bench.ts"
    ]
  },
  "targetDefaults": {
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "@nx/eslint:lint": {
      "cache": true,
      "options": {
        "maxWarnings": 192
      },
      "inputs": [
        "default",
        "^default",
        "^production",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/scripts/placement-tags-plugin.ts"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/test-results/{projectName}"]
    },
    "nx-release-publish": {
      "cache": false,
      "dependsOn": ["build"]
    }
  },
  "release": {
    "projects": ["tag:release:cli"],
    "projectsRelationship": "fixed",
    "versionPlans": {
      "ignorePatternsForPlanCheck": ["{projectRoot}/vitest*.config.ts", "vitest.execution.ts"]
    },
    "releaseTag": {
      "pattern": "cli-v{version}",
      "requireSemver": true
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": false,
      "automaticFromRef": true
    },
    "version": {
      "currentVersionResolver": "disk"
    }
  },
  "analytics": false
}
