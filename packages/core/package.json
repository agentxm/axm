{
  "name": "@agentxm/core",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./experimental/paths": {
      "types": "./dist/experimental/paths.d.ts",
      "import": "./dist/experimental/paths.js"
    },
    "./experimental/skills": {
      "types": "./dist/experimental/skills/index.d.ts",
      "import": "./dist/experimental/skills/index.js"
    },
    "./experimental/skills/state": {
      "types": "./dist/experimental/skills/state/index.d.ts",
      "import": "./dist/experimental/skills/state/index.js"
    },
    "./experimental/resolution": {
      "types": "./dist/experimental/resolution/index.d.ts",
      "import": "./dist/experimental/resolution/index.js"
    },
    "./experimental/schemas": {
      "types": "./dist/experimental/schemas/index.d.ts",
      "import": "./dist/experimental/schemas/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:schemas": "bun scripts/generate-schemas.ts",
    "check:schemas": "bun scripts/check-schemas.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@effect/platform": "^0.94.2",
    "effect": "catalog:",
    "simple-git": "^3.27.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@effect/platform-node": "^0.104.1",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
