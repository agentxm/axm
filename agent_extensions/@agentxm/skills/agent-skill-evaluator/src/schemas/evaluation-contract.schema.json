{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentxm.dev/schemas/agent-skill-evaluator/evaluation-contract-3.0.0.json",
  "title": "Agent Skill evaluation contract",
  "type": "object",
  "required": [
    "contract_version",
    "owner",
    "decision",
    "target_binding",
    "scope",
    "unit",
    "environment",
    "evidence",
    "grading",
    "trials",
    "comparison",
    "analysis",
    "estimand",
    "lifecycle",
    "provenance",
    "freshness"
  ],
  "properties": {
    "contract_version": { "enum": ["2.0.0", "3.0.0"] },
    "owner": { "type": "string" },
    "decision": { "type": "string" },
    "target_binding": {
      "type": "object",
      "required": ["skill_name", "required_result_fields"],
      "properties": {
        "skill_name": { "type": "string" },
        "required_result_fields": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z_]+(?:\\.[a-z_]+)*$" },
          "uniqueItems": true
        }
      }
    },
    "scope": { "type": "object" },
    "unit": { "type": "string" },
    "environment": { "type": "object" },
    "evidence": { "type": "object" },
    "grading": { "type": "object" },
    "trials": { "type": "object" },
    "comparison": { "type": "object" },
    "analysis": {
      "type": "object",
      "properties": {
        "critical_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate", "case_id", "assertion"],
            "properties": {
              "gate": { "type": "string", "minLength": 1 },
              "case_id": { "type": ["string", "integer"] },
              "assertion": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "estimand": {
      "type": "object",
      "required": ["type", "sampling_unit", "uncertainty"],
      "properties": {
        "type": { "const": "fixed-suite" },
        "sampling_unit": { "type": "string" },
        "uncertainty": { "type": "string" }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["preflight_failure", "terminal_states", "retry", "resume"],
      "properties": {
        "preflight_failure": { "type": "string" },
        "terminal_states": {
          "type": "array",
          "items": { "enum": ["complete", "failed", "canceled"] },
          "uniqueItems": true
        },
        "retry": { "type": "string" },
        "resume": { "type": "string" }
      }
    },
    "provenance": { "type": "object" },
    "freshness": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "contract_version": { "const": "3.0.0" } } },
      "then": { "properties": { "analysis": { "required": ["critical_assertions"] } } }
    }
  ]
}
