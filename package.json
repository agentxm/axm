{
  "name": "agentxm-oss",
  "private": true,
  "type": "module",
  "scripts": {
    "axm": "bun packages/cli/src/main.ts",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "vitest run --root packages/cli -c vitest.e2e.config.ts",
    "typecheck": "pnpm -r typecheck",
    "format": "biome format --write . && prettier --write \"**/*.md\"",
    "format:check": "biome format . && prettier --check \"**/*.md\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "prepare": "husky && effect-language-service patch"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": "biome check --write --no-errors-on-unmatched",
    "*.md": "prettier --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@effect/language-service": "^0.72.0",
    "@effect/vitest": "^0.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
