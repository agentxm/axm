{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "axm",
  "root": ".",
  "tags": ["type:tooling", "scope:root"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["eslint.config.mjs", "vitest.config.ts"]
      }
    },
    "scripts-lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/scripts/**/*",
        "sharedGlobals",
        "{workspaceRoot}/eslint.config.mjs"
      ],
      "options": {
        "command": "pnpm scripts-lint",
        "cwd": "."
      }
    },
    "scripts-typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["utils:build"],
      "inputs": ["{workspaceRoot}/package.json", "{workspaceRoot}/scripts/**/*", "sharedGlobals"],
      "options": {
        "command": "pnpm scripts-typecheck",
        "cwd": "."
      }
    },
    "scripts-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["utils:build"],
      "inputs": ["{workspaceRoot}/package.json", "{workspaceRoot}/scripts/**/*", "sharedGlobals"],
      "options": {
        "command": "pnpm scripts-test",
        "cwd": "."
      }
    },
    "release-prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "pnpm release-prepare",
        "cwd": "."
      }
    },
    "release-publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "pnpm release-publish",
        "cwd": "."
      }
    },
    "release-publish-local": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "pnpm release-publish-local",
        "cwd": "."
      }
    },
    "validate-release-tag": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "pnpm validate-release-tag",
        "cwd": "."
      }
    },
    "resolve-release-meta": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "pnpm resolve-release-meta",
        "cwd": "."
      }
    },
    "download-ci-binaries": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "pnpm download-ci-binaries",
        "cwd": "."
      }
    },
    "validate-release-assets": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm validate-release-assets",
        "cwd": "."
      }
    },
    "update-homebrew-formula": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm update-homebrew-formula",
        "cwd": "."
      }
    },
    "verify-source-hygiene": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/scripts/**/*",
        "sharedGlobals",
        "{workspaceRoot}/packages/*/src/**/*"
      ],
      "options": {
        "command": "pnpm verify-source-hygiene",
        "cwd": "."
      }
    },
    "verify-e2e-boundaries": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/scripts/**/*",
        "sharedGlobals",
        "{workspaceRoot}/packages/e2e-utils/package.json",
        "{workspaceRoot}/packages/e2e-utils/**/tsconfig*.json",
        "{workspaceRoot}/packages/cli-e2e/package.json",
        "{workspaceRoot}/packages/cli-e2e/**/tsconfig*.json",
        "{workspaceRoot}/packages/cli-spike-e2e/package.json",
        "{workspaceRoot}/packages/cli-spike-e2e/**/tsconfig*.json"
      ],
      "options": {
        "command": "pnpm verify-e2e-boundaries",
        "cwd": "."
      }
    },
    "generate-registry": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "pnpm generate-registry",
        "cwd": "."
      }
    },
    "generate-telemetry": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "pnpm generate-telemetry",
        "cwd": "."
      }
    },
    "ci": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          {
            "command": "pnpm exec nx run-many -t lint typecheck build test e2e --batch --nxBail --outputStyle=static"
          },
          {
            "command": "pnpm exec nx run axm:scripts-lint --outputStyle=static"
          },
          {
            "command": "pnpm exec nx run axm:scripts-typecheck --outputStyle=static"
          },
          {
            "command": "pnpm exec nx run axm:scripts-test --outputStyle=static"
          },
          {
            "command": "pnpm exec nx run axm:verify-e2e-boundaries --outputStyle=static"
          },
          {
            "command": "pnpm exec nx run axm:verify-source-hygiene --outputStyle=static"
          }
        ]
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          {
            "command": "pnpm run check:ci-image"
          },
          {
            "command": "pnpm run generate:check"
          },
          {
            "command": "pnpm exec nx sync:check"
          },
          {
            "command": "pnpm exec nx format:check"
          },
          {
            "command": "pnpm exec nx run axm:ci --outputStyle=static"
          }
        ]
      }
    },
    "verify-affected": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          {
            "command": "pnpm run check:ci-image"
          },
          {
            "command": "pnpm run generate:check"
          },
          {
            "command": "pnpm exec nx sync:check"
          },
          {
            "command": "pnpm exec nx format:check"
          },
          {
            "command": "pnpm exec nx affected -t lint typecheck build test e2e --batch --nxBail --outputStyle=static"
          },
          {
            "command": "pnpm exec nx run axm:scripts-lint --outputStyle=static"
          },
          {
            "command": "pnpm exec nx run axm:scripts-typecheck --outputStyle=static"
          },
          {
            "command": "pnpm exec nx run axm:scripts-test --outputStyle=static"
          },
          {
            "command": "pnpm exec nx run axm:verify-e2e-boundaries --outputStyle=static"
          },
          {
            "command": "pnpm exec nx run axm:verify-source-hygiene --outputStyle=static"
          }
        ]
      }
    }
  }
}
