{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "parallel": 2,
  "maxCacheSize": "2GB",
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json"
        },
        "typecheck": {
          "targetName": "typecheck",
          "configName": "tsconfig.json"
        }
      }
    }
  ],
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "namedInputs": {
    "sharedGlobals": ["{workspaceRoot}/tsconfig*.json", "{workspaceRoot}/vitest.reporting.ts"],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.e2e.test.ts",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.type-test.ts",
      "!{projectRoot}/vitest*.config.ts",
      "!{projectRoot}/**/*.bench.ts"
    ]
  },
  "targetDefaults": {
    "@nx/eslint:lint": {
      "cache": true,
      "options": {
        "maxWarnings": 192
      },
      "inputs": [
        "default",
        "^default",
        "^production",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/{projectName}"]
    }
  },
  "release": {
    "projects": ["utils", "core", "cli"],
    "projectsRelationship": "fixed",
    "versionPlans": true,
    "releaseTag": {
      "pattern": "cli-v{version}",
      "requireSemver": true
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": false,
      "automaticFromRef": true
    },
    "version": {
      "currentVersionResolver": "disk",
      "preVersionCommand": "pnpm run ci"
    }
  },
  "analytics": false
}
