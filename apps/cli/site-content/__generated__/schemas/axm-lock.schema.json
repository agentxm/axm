{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/LockfileEncoded",
  "definitions": {
    "Version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "title": "Version",
      "description": "A semver version like 1.0.0. Ranges are not allowed here.",
      "examples": ["1.0.0", "2.3.1", "0.1.0-beta.1"]
    },
    "ArchiveIntegrity": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/]{85}[AQgw]==(?![\\s\\S])"
    },
    "TreeIntegrity": {
      "type": "string",
      "pattern": "^sha256-tree-v2:[0-9a-f]{64}(?![\\s\\S])",
      "description": "Strict SHA-256 integrity of paths, entry kinds, file bytes, executable bits, and contained link targets using AXM materialized-tree framing v2."
    },
    "NonPackExtensionFqn": {
      "type": "string",
      "pattern": "^(@[a-z0-9_](?:[a-z0-9_-]*[a-z0-9_])?)\\/(skills|mcps|subagents|rules|hooks|knowledge)\\/([a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)$",
      "title": "Non-Pack Extension FQN",
      "description": "Extension identifier restricted to non-pack types (skills, mcps, subagents, rules, hooks, knowledge).",
      "examples": ["@acme/skills/code-review", "@my-org/rules/typescript"]
    },
    "VersionRange": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[~^<>=*xXvV0-9A-Za-z+| .-]+$",
      "title": "Version Range",
      "description": "A semver version range like ^1.0.0, ~2.3.0, >=1.0.0 <3.0.0, or an exact version 1.2.3. Use \"*\" to always resolve to the latest available version.",
      "examples": ["^1.0.0", "~2.4", ">=1 <3", "1.2.3", "*"]
    },
    "SourceSubPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\.(?:\\/|(?![\\s\\S])))[^/]+(?:\\/(?!\\.\\.(?:\\/|(?![\\s\\S])))[^/]+)*(?![\\s\\S])",
      "title": "Source Subpath",
      "description": "A non-empty repository subpath without empty or '..' traversal segments."
    },
    "GitSha1ObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])" },
    "GitSha256ObjectId": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" },
    "ExtensionName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?![\\s\\S])",
      "title": "Extension Name",
      "description": "The name of an extension — lowercase letters, numbers, and hyphens (e.g. my-skill).",
      "examples": ["my-skill", "code-review", "prettier"]
    },
    "LockfileEncoded": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "enum": [1],
          "description": "Lockfile format version.",
          "default": 1
        },
        "package": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "source": {
                    "type": "object",
                    "properties": {
                      "registry": {
                        "type": "string",
                        "description": "Registry location: an http(s) origin or a file URL, without credentials, query, or fragment; a trailing slash is not significant.",
                        "examples": ["https://registry.agentxm.ai", "file:///srv/registry"]
                      }
                    },
                    "required": ["registry"],
                    "additionalProperties": false
                  },
                  "version": { "$ref": "#/definitions/Version" },
                  "archive": { "$ref": "#/definitions/ArchiveIntegrity" },
                  "publisher": { "type": "string", "minLength": 1 },
                  "tree": { "$ref": "#/definitions/TreeIntegrity" },
                  "manifest-version": { "$ref": "#/definitions/Version" },
                  "manifest-identity": {
                    "type": "string",
                    "description": "Semantic consistency digest over the accepted Pack identity, manifest version, and dependency declarations. It is not an authenticity signature."
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "name": { "$ref": "#/definitions/NonPackExtensionFqn" },
                            "range": { "$ref": "#/definitions/VersionRange" },
                            "registry": {
                              "type": "string",
                              "description": "Registry location: an http(s) origin or a file URL, without credentials, query, or fragment; a trailing slash is not significant.",
                              "examples": ["https://registry.agentxm.ai", "file:///srv/registry"]
                            }
                          },
                          "required": ["name", "range", "registry"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "name": { "$ref": "#/definitions/NonPackExtensionFqn" },
                            "range": { "$ref": "#/definitions/VersionRange" }
                          },
                          "required": ["name", "range"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": ["id", "source", "version", "archive", "publisher", "tree"],
                "additionalProperties": false
              },
