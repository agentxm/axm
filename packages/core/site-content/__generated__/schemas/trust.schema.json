{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/WorkspaceTrustState",
  "definitions": {
    "ExtensionType": {
      "type": "string",
      "enum": [
        "skill",
        "command",
        "mcp-server",
        "subagent",
        "files",
        "rule",
        "hook",
        "knowledge",
        "pack"
      ],
      "title": "Extension Type",
      "description": "What kind of extension this is: skill, command, mcp-server, subagent, context, rule, hook, knowledge, or pack."
    },
    "ExtensionTrustRecord": {
      "type": "object",
      "properties": {
        "extensionType": { "$ref": "#/definitions/ExtensionType" },
        "name": { "type": "string" },
        "authority": {
          "type": "string",
          "enum": [
            "registry",
            "github",
            "gitlab",
            "bitbucket",
            "azurerepos",
            "git",
            "local",
            "workspace",
            "inline"
          ]
        },
        "sourceIdentity": { "type": "string" },
        "sourceName": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "resolvedVersion": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "immutableRevision": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "publisherBindingId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "integrity": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "contentIdentity": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["extensionType", "name", "authority", "sourceIdentity"],
      "additionalProperties": false,
      "title": "Extension Trust Record",
      "description": "Security-critical source and publisher identity for one known extension identity. Historical timestamps and materialization results are intentionally excluded."
    },
    "WorkspaceTrustState": {
      "type": "object",
      "properties": {
        "$schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "trustStateVersion": { "type": "number", "enum": [1] },
        "records": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/ExtensionTrustRecord" }
        }
      },
      "required": ["trustStateVersion", "records"],
      "additionalProperties": false,
      "title": "Workspace Trust State",
      "description": "Authoritative source, resolution, and publisher-epoch baselines used to prevent wrong-origin canonical reuse."
    }
  }
}
