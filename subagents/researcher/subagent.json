{
  "$schema": "https://axm.sh/schemas/subagent.schema.json",
  "owner": "@agentxm",
  "type": "subagent",
  "name": "researcher",
  "version": "0.1.0",
  "description": "Performs one fresh-context, read-only Research Brief framing or evidence-gathering phase",
  "keywords": [
    "research",
    "delegation",
    "evidence",
    "citations",
    "framing",
    "isolation",
    "read-only"
  ],
  "core": {
    "instructions": "src/researcher.md"
  },
  "implementations": {
    "codex": {
      "kind": "customized",
      "configuration": {
        "sandbox_mode": "read-only"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm",
    "directory": "subagents/researcher"
  },
  "homepage": "https://github.com/craigsmitham/agent-extensions",
  "license": "MIT"
}
