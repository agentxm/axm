{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/WorkspaceTrustState",
  "definitions": {
    "Union_": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "ExtensionType": {
      "type": "string",
      "enum": ["skill", "mcp-server", "subagent", "rule", "hook", "knowledge", "pack"],
      "title": "Extension Type",
      "description": "What kind of extension this is: skill, mcp-server, subagent, rule, hook, knowledge, or pack."
    },
    "ExtensionTrustRecord": {
      "type": "object",
      "properties": {
        "extensionType": { "$ref": "#/definitions/ExtensionType" },
        "name": { "type": "string" },
        "authority": {
          "type": "string",
          "enum": [
            "registry",
            "github",
            "gitlab",
            "bitbucket",
            "azurerepos",
            "git",
            "local",
            "workspace",
            "inline"
          ]
        },
        "sourceIdentity": { "type": "string" },
        "sourceName": { "$ref": "#/definitions/Union_" },
        "resolvedVersion": { "$ref": "#/definitions/Union_" },
        "immutableRevision": { "$ref": "#/definitions/Union_" },
        "publisherBindingId": { "$ref": "#/definitions/Union_" },
        "integrity": { "$ref": "#/definitions/Union_" },
        "contentIdentity": { "$ref": "#/definitions/Union_" },
        "packManifest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "owner": { "type": "string" },
                "name": { "type": "string" },
                "version": { "type": "string" },
                "dependencies": { "type": "object", "additionalProperties": { "type": "string" } },
                "metadataIdentity": { "type": "string" }
              },
              "required": ["owner", "name", "version", "dependencies", "metadataIdentity"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["extensionType", "name", "authority", "sourceIdentity"],
      "additionalProperties": false,
      "title": "Extension Trust Record",
      "description": "Security-critical source and publisher identity for one known extension identity. Historical timestamps and materialization results are intentionally excluded."
    },
    "WorkspaceTrustState": {
      "type": "object",
      "properties": {
        "$schema": { "$ref": "#/definitions/Union_" },
        "trustStateVersion": { "type": "number", "enum": [1] },
        "records": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/ExtensionTrustRecord" }
        }
      },
      "required": ["trustStateVersion", "records"],
      "additionalProperties": false,
      "title": "Workspace Trust State",
      "description": "Authoritative source, resolution, and publisher-epoch baselines used to prevent wrong-origin canonical reuse."
    }
  }
}
