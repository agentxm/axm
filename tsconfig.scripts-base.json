{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false,
        "allowedUnstableApis": [
          "@effect/platform-node",
          "@effect/vitest",
          "effect/ByteSize",
          "effect/cli",
          "effect/FileSystem",
          "effect/http",
          "effect/process",
          "effect/encoding/Sse",
          "effect/Path",
          "effect/PlatformError",
          "effect/Stdio",
          "effect/Terminal"
        ],
        "diagnosticSeverity": {
          "preferSchemaOverJson": "off",
          "unnecessaryFailYieldableError": "warning",
          "multipleEffectProvide": "warning",
          "deterministicKeys": "error",
          "returnEffectInGen": "error",
          "tryCatchInEffectGen": "warning",
          "leakingRequirements": "warning",
          "globalConsole": "off",
          "globalConsoleInEffect": "off",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "nodeBuiltinImport": "off",
          "effectFnOpportunity": "suggestion",
          "schemaStructWithTag": "suggestion"
        }
      }
    ]
  }
}
