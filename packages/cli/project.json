{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli",
  "projectType": "application",
  "root": "packages/cli",
  "sourceRoot": "packages/cli/src",
  "tags": ["type:app", "scope:cli"],
  "targets": {
    "build": {
      "cache": true,
      "dependsOn": ["generate", "^build"],
      "executor": "@nx/js:tsc",
      "inputs": [
        "production",
        "{projectRoot}/help/topics/*.md",
        "{workspaceRoot}/.axm/extensions/@agentxm/skills/axm/skill.json",
        "{workspaceRoot}/.axm/extensions/@agentxm/skills/axm/src/SKILL.md",
        "^production"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "main": "packages/cli/src/main.ts",
        "outputPath": "packages/cli/dist",
        "tsConfig": "packages/cli/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false
      }
    },
    "watch": {
      "cache": false,
      "dependsOn": ["^build"],
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/cli/src/main.ts",
        "outputPath": "packages/cli/dist",
        "tsConfig": "packages/cli/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false,
        "watch": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": ["generate"],
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{ts,tsx,js,mjs,cjs}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "packages/cli"
      }
    },
    "generate": {
      "dependsOn": ["generate:help-topics", "generate:bundled-axm-skill"],
      "executor": "nx:run-commands",
      "options": {
        "command": "echo cli generated output is up to date"
      }
    },
    "generate:help-topics": {
      "cache": true,
      "dependsOn": [{ "projects": ["core"], "target": "generate:schemas" }],
      "inputs": [
        "{projectRoot}/help/topics/*.md",
        "{projectRoot}/scripts/generate-help-topics.ts",
        "{workspaceRoot}/packages/core/site-content/__generated__/schemas/*.schema.json"
      ],
      "outputs": ["{projectRoot}/src/__generated__/help-topics.ts"],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/generate-help-topics.ts"],
        "cwd": "packages/cli"
      }
    },
    "generate:bundled-axm-skill": {
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/generate-bundled-axm-skill.ts",
        "{workspaceRoot}/.axm/extensions/@agentxm/skills/axm/skill.json",
        "{workspaceRoot}/.axm/extensions/@agentxm/skills/axm/src/SKILL.md"
      ],
      "outputs": ["{projectRoot}/src/__generated__/bundled-axm-skill.ts"],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/generate-bundled-axm-skill.ts"],
        "cwd": "packages/cli"
      }
    },
    "compile": {
      "cache": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/bin"],
      "options": {
        "command": ["bun", "scripts/compile.ts"],
        "cwd": "packages/cli"
      }
    },
    "compile-host": {
      "cache": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/bin"],
      "options": {
        "command": ["bun", "scripts/compile.ts", "--host-only"],
        "cwd": "packages/cli"
      }
    },
    "compile-host-dev": {
      "cache": false,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/dev-bin"],
      "options": {
        "command": ["bun", "scripts/compile.ts", "--host-only", "--dev-build"],
        "cwd": "packages/cli"
      }
    },
    "nx-release-publish": {
      "cache": false,
      "dependsOn": ["build", "^nx-release-publish"],
      "executor": "@nx/js:release-publish"
    }
  }
}
