{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentxm.dev/schemas/agent-skill-evaluator/trial-1.0.0.json",
  "title": "Agent Skill evaluation trial",
  "type": "object",
  "required": ["schema_version", "case_id", "stage", "routing_mode", "configuration_id", "configuration_role", "trial_number", "comparison_position", "final_attempt_number", "raw_output_or_durable_locator", "observed_selection_or_abstention", "assertion_results", "side_effects", "observations", "usage", "outcome", "failure_class"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "case_id": { "type": ["string", "integer"] },
    "stage": { "enum": ["routing", "execution"] },
    "routing_mode": { "type": ["string", "null"] },
    "configuration_id": { "type": "string" },
    "configuration_role": { "enum": ["candidate", "baseline"] },
    "trial_number": { "type": "integer", "minimum": 1 },
    "comparison_position": { "type": "integer", "minimum": 1 },
    "final_attempt_number": { "type": "integer", "minimum": 1 },
    "raw_output_or_durable_locator": { "type": ["string", "null"] },
    "observed_selection_or_abstention": { "type": ["string", "array", "null"] },
    "assertion_results": { "type": "string" },
    "side_effects": { "type": "array" },
    "observations": { "type": "object" },
    "usage": { "type": "object" },
    "outcome": { "enum": ["pass", "fail", "unknown", "harness-error"] },
    "failure_class": { "type": ["string", "null"] }
  }
}
