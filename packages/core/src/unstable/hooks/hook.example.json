{
  "$schema": "https://axm.sh/schemas/hook.schema.json",
  "type": "hook",
  "owner": "@acme",
  "name": "tool-audit",
  "version": "0.1.0",
  "description": "Blocks writes that look like secrets.",
  "runtime": "bash",
  "entrypoint": "src/hook.sh",
  "bindings": [
    {
      "on": "tool.pre",
      "match": { "tools": ["file.write", "file.edit"] },
      "requires": { "decision": { "kind": "block" } }
    }
  ],
  "timeoutMs": 5000,
  "capabilities": {
    "network": false,
    "filesystemWrite": false,
    "exec": [],
    "env": []
  }
}
