{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [],
  "properties": {
    "namespace": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "required": [],
      "properties": {
        "github": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "gitlab": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "bitbucket": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "azurerepos": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "git": {
          "$id": "/schemas/%7B%7D",
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        },
        "registry": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": ["url"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": ["path"],
                  "additionalProperties": false
                }
              ],
              "description": "Registry source with either url or path (but not both)"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      }
                    },
                    "required": ["url"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": ["path"],
                    "additionalProperties": false
                  }
                ],
                "description": "Registry source with either url or path (but not both)"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "adal",
          "amp",
          "antigravity",
          "augment",
          "claude-code",
          "cline",
          "codebuddy",
          "codex",
          "command-code",
          "continue",
          "crush",
          "cursor",
          "droid",
          "gemini-cli",
          "github-copilot",
          "goose",
          "iflow-cli",
          "junie",
          "kilo",
          "kimi-cli",
          "kiro-cli",
          "kode",
          "mcpjam",
          "mistral-vibe",
          "mux",
          "neovate",
          "openclaw",
          "opencode",
          "openhands",
          "pi",
          "pochi",
          "qoder",
          "qwen-code",
          "replit",
          "roo",
          "trae",
          "trae-cn",
          "windsurf",
          "zencoder"
        ]
      }
    },
    "skills": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "commands": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "packs": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "mcp-servers": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
