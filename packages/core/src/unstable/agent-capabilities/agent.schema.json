{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Agent",
  "definitions": {
    "AgentIdFromYaml": {
      "type": "string",
      "allOf": [
        { "minLength": 1 },
        {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Agent ID",
          "description": "Lowercase kebab-case coding agent identifier.",
          "examples": ["claude-code", "codex", "cursor"]
        }
      ]
    },
    "AgentInterface": {
      "type": "string",
      "enum": ["cli", "ide-extension"],
      "title": "Agent Interface",
      "description": "Primary product interface where the agent runs.",
      "examples": ["cli", "ide-extension"]
    },
    "DocLink": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "allOf": [{ "minLength": 1 }] },
        "url": { "type": "string", "allOf": [{ "minLength": 1 }] }
      },
      "required": ["label", "url"],
      "additionalProperties": false,
      "title": "Documentation Link",
      "description": "Documentation reference for an agent or capability."
    },
    "SupportLevel": {
      "type": "string",
      "enum": ["standard", "bridged", "planned", "unsupported", "unknown"],
      "title": "Support Level",
      "description": "How an agent supports a capability. `standard`: the agent natively conforms to an industry spec standard for the capability (e.g. the Agent Skills `SKILL.md` format). `bridged`: the capability works through an AXM adapter that maps it to the agent's native format — this is the ceiling for capabilities that have no industry spec standard yet, such as subagents and commands. `planned`: AXM support is intended but not yet available. `unsupported`: an authoritative source confirms the agent lacks the capability. `unknown`: support has not been verified, normally expressed by omitting the capability section entirely.",
      "examples": ["standard", "bridged", "unknown"]
    },
    "LastVerifiedDate": {
      "type": "string",
      "allOf": [
        { "minLength": 1 },
        {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Last Verified Date",
          "description": "Date a capability claim was last verified.",
          "examples": ["2026-05-16"]
        }
      ]
    },
    "Scope": {
      "type": "string",
      "enum": ["user", "project"],
      "title": "Scope",
      "description": "Where a capability can be configured.",
      "examples": ["user", "project"]
    },
    "SkillsCapability": {
      "type": "object",
      "properties": {
        "support": { "$ref": "#/definitions/SupportLevel" },
        "notes": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        },
        "docs": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/DocLink" } },
            { "type": "null" }
          ]
        },
        "sources": {
          "anyOf": [
            { "type": "array", "items": { "type": "string", "allOf": [{ "minLength": 1 }] } },
            { "type": "null" }
          ]
        },
        "lastVerified": {
          "anyOf": [{ "$ref": "#/definitions/LastVerifiedDate" }, { "type": "null" }]
        },
        "scopes": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "$ref": "#/definitions/Scope" }
        },
        "directory": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        }
      },
      "required": ["support", "scopes"],
      "additionalProperties": false,
      "title": "Skills Capability",
      "description": "Agent support for Agent Skills-style extensions."
    },
    "CommandsCapability": {
      "type": "object",
      "properties": {
        "support": { "$ref": "#/definitions/SupportLevel" },
        "notes": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        },
        "docs": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/DocLink" } },
            { "type": "null" }
          ]
        },
        "sources": {
          "anyOf": [
            { "type": "array", "items": { "type": "string", "allOf": [{ "minLength": 1 }] } },
            { "type": "null" }
          ]
        },
        "lastVerified": {
          "anyOf": [{ "$ref": "#/definitions/LastVerifiedDate" }, { "type": "null" }]
        },
        "scopes": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "$ref": "#/definitions/Scope" }
        },
        "directory": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        }
      },
      "required": ["support", "scopes"],
      "additionalProperties": false,
      "title": "Commands Capability",
      "description": "Agent support for command extensions."
    },
    "McpTransport": {
      "type": "string",
      "enum": ["stdio", "http", "sse"],
      "title": "MCP Transport",
      "description": "MCP transport supported by an agent.",
      "examples": ["stdio", "http", "sse"]
    },
    "McpCapability": {
      "type": "object",
      "properties": {
        "support": { "$ref": "#/definitions/SupportLevel" },
        "notes": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        },
        "docs": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/DocLink" } },
            { "type": "null" }
          ]
        },
        "sources": {
          "anyOf": [
            { "type": "array", "items": { "type": "string", "allOf": [{ "minLength": 1 }] } },
            { "type": "null" }
          ]
        },
        "lastVerified": {
          "anyOf": [{ "$ref": "#/definitions/LastVerifiedDate" }, { "type": "null" }]
        },
        "scopes": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "$ref": "#/definitions/Scope" }
        },
        "transports": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "$ref": "#/definitions/McpTransport" }
        }
      },
      "required": ["support", "scopes", "transports"],
      "additionalProperties": false,
      "title": "MCP Capability",
      "description": "Agent support for MCP server extensions."
    },
    "SubagentsCapability": {
      "type": "object",
      "properties": {
        "support": { "$ref": "#/definitions/SupportLevel" },
        "notes": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        },
        "docs": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/DocLink" } },
            { "type": "null" }
          ]
        },
        "sources": {
          "anyOf": [
            { "type": "array", "items": { "type": "string", "allOf": [{ "minLength": 1 }] } },
            { "type": "null" }
          ]
        },
        "lastVerified": {
          "anyOf": [{ "$ref": "#/definitions/LastVerifiedDate" }, { "type": "null" }]
        },
        "scopes": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "$ref": "#/definitions/Scope" }
        }
      },
      "required": ["support", "scopes"],
      "additionalProperties": false,
      "title": "Subagents Capability",
      "description": "Agent support for subagent extensions."
    },
    "InstructionsCapability": {
      "type": "object",
      "properties": {
        "support": { "$ref": "#/definitions/SupportLevel" },
        "notes": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        },
        "docs": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/DocLink" } },
            { "type": "null" }
          ]
        },
        "sources": {
          "anyOf": [
            { "type": "array", "items": { "type": "string", "allOf": [{ "minLength": 1 }] } },
            { "type": "null" }
          ]
        },
        "lastVerified": {
          "anyOf": [{ "$ref": "#/definitions/LastVerifiedDate" }, { "type": "null" }]
        },
        "scopes": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "$ref": "#/definitions/Scope" }
        },
        "files": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "type": "string", "allOf": [{ "minLength": 1 }] }
        },
        "nestedDiscovery": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] }
      },
      "required": ["support", "scopes", "files"],
      "additionalProperties": false,
      "title": "Instructions Capability",
      "description": "Agent support for plain prose instruction files."
    },
    "RulesCapability": {
      "type": "object",
      "properties": {
        "support": { "$ref": "#/definitions/SupportLevel" },
        "notes": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        },
        "docs": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/DocLink" } },
            { "type": "null" }
          ]
        },
        "sources": {
          "anyOf": [
            { "type": "array", "items": { "type": "string", "allOf": [{ "minLength": 1 }] } },
            { "type": "null" }
          ]
        },
        "lastVerified": {
          "anyOf": [{ "$ref": "#/definitions/LastVerifiedDate" }, { "type": "null" }]
        },
        "scopes": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "$ref": "#/definitions/Scope" }
        },
        "directory": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        }
      },
      "required": ["support", "scopes"],
      "additionalProperties": false,
      "title": "Rules Capability",
      "description": "Agent support for structured rule files."
    },
    "PermissionMechanism": {
      "type": "string",
      "enum": ["config-file", "cli-flag", "ui-only"],
      "title": "Permission Mechanism",
      "description": "How an agent exposes permission configuration.",
      "examples": ["config-file", "cli-flag", "ui-only"]
    },
    "ConfigFileFormat": {
      "type": "string",
      "enum": ["json", "jsonc", "toml", "starlark", "vscode-settings"],
      "title": "Config File Format",
      "description": "Serialization format used by an agent's permission config file.",
      "examples": ["json", "toml", "vscode-settings"]
    },
    "ConfigFileLocation": {
      "type": "object",
      "properties": {
        "scope": { "$ref": "#/definitions/Scope" },
        "path": { "type": "string", "allOf": [{ "minLength": 1 }] },
        "format": { "$ref": "#/definitions/ConfigFileFormat" },
        "gitignored": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] }
      },
      "required": ["scope", "path", "format"],
      "additionalProperties": false,
      "title": "Config File Location",
      "description": "A configuration file where an agent's permission rules can live."
    },
    "PermissionGrammarStyle": {
      "type": "string",
      "enum": ["tool-call", "prefix", "regex", "glob", "starlark-rule"],
      "title": "Permission Grammar Style",
      "description": "Syntax shape used to express a permission rule.",
      "examples": ["tool-call", "prefix", "regex"]
    },
    "PermissionGrammar": {
      "type": "object",
      "properties": {
        "style": { "$ref": "#/definitions/PermissionGrammarStyle" },
        "example": { "type": "string", "allOf": [{ "minLength": 1 }] },
        "notes": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        }
      },
      "required": ["style", "example"],
      "additionalProperties": false,
      "title": "Permission Grammar",
      "description": "Rule syntax used by an agent's permission system."
    },
    "PermissionPrerequisite": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "allOf": [{ "minLength": 1 }] },
        "value": { "type": "string", "allOf": [{ "minLength": 1 }] },
        "scope": { "$ref": "#/definitions/Scope" },
        "note": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        }
      },
      "required": ["key", "value", "scope"],
      "additionalProperties": false,
      "title": "Permission Prerequisite",
      "description": "Mode or gate that must be set before allow rules take effect."
    },
    "PermissionCliFlag": {
      "type": "object",
      "properties": {
        "flag": { "type": "string", "allOf": [{ "minLength": 1 }] },
        "note": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        }
      },
      "required": ["flag"],
      "additionalProperties": false,
      "title": "Permission CLI Flag",
      "description": "Invocation-time flag that adjusts approval or sandbox behavior."
    },
    "PermissionGrant": {
      "type": "object",
      "properties": {
        "target": { "type": "string", "allOf": [{ "minLength": 1 }] },
        "patch": { "anyOf": [{}, { "type": "null" }] },
        "template": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        }
      },
      "required": ["target"],
      "additionalProperties": false,
      "title": "Permission Grant",
      "description": "Instruction to grant access for a named tool. Provide patch (JSON-ish merge) or template (raw text). Path and patch may interpolate ${tool} and ${workspaceRoot}."
    },
    "PermissionsCapability": {
      "type": "object",
      "properties": {
        "support": { "$ref": "#/definitions/SupportLevel" },
        "notes": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        },
        "docs": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/DocLink" } },
            { "type": "null" }
          ]
        },
        "sources": {
          "anyOf": [
            { "type": "array", "items": { "type": "string", "allOf": [{ "minLength": 1 }] } },
            { "type": "null" }
          ]
        },
        "lastVerified": {
          "anyOf": [{ "$ref": "#/definitions/LastVerifiedDate" }, { "type": "null" }]
        },
        "scopes": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "$ref": "#/definitions/Scope" }
        },
        "mechanism": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "$ref": "#/definitions/PermissionMechanism" }
        },
        "configFiles": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/ConfigFileLocation" } },
            { "type": "null" }
          ]
        },
        "grammar": { "anyOf": [{ "$ref": "#/definitions/PermissionGrammar" }, { "type": "null" }] },
        "prerequisites": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/PermissionPrerequisite" } },
            { "type": "null" }
          ]
        },
        "cliFlags": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/PermissionCliFlag" } },
            { "type": "null" }
          ]
        },
        "grants": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/PermissionGrant" }
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["support", "scopes", "mechanism"],
      "additionalProperties": false,
      "title": "Permissions Capability",
      "description": "How an agent grants tool execution and filesystem access without per-call prompts."
    },
    "Agent": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/AgentIdFromYaml" },
        "name": { "type": "string", "allOf": [{ "minLength": 1 }] },
        "vendor": { "type": "string", "allOf": [{ "minLength": 1 }] },
        "homepage": { "type": "string", "allOf": [{ "minLength": 1 }] },
        "interfaces": {
          "type": "array",
          "allOf": [{ "uniqueItems": true }],
          "items": { "$ref": "#/definitions/AgentInterface" }
        },
        "family": {
          "anyOf": [{ "type": "string", "allOf": [{ "minLength": 1 }] }, { "type": "null" }]
        },
        "docs": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/definitions/DocLink" } },
            { "type": "null" }
          ]
        },
        "skills": { "anyOf": [{ "$ref": "#/definitions/SkillsCapability" }, { "type": "null" }] },
        "commands": {
          "anyOf": [{ "$ref": "#/definitions/CommandsCapability" }, { "type": "null" }]
        },
        "mcp": { "anyOf": [{ "$ref": "#/definitions/McpCapability" }, { "type": "null" }] },
        "subagents": {
          "anyOf": [{ "$ref": "#/definitions/SubagentsCapability" }, { "type": "null" }]
        },
        "instructions": {
          "anyOf": [{ "$ref": "#/definitions/InstructionsCapability" }, { "type": "null" }]
        },
        "rules": { "anyOf": [{ "$ref": "#/definitions/RulesCapability" }, { "type": "null" }] },
        "permissions": {
          "anyOf": [{ "$ref": "#/definitions/PermissionsCapability" }, { "type": "null" }]
        }
      },
      "required": ["id", "name", "vendor", "homepage", "interfaces"],
      "additionalProperties": false,
      "title": "Agent",
      "description": "AI coding agent and its verified extension capability claims."
    }
  }
}
