  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm.git",
    "directory": "packages/core/workspace-reconciliation"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
