{
  "name": "@agentxm/example-tinyflags",
  "version": "0.1.0",
  "description": "Tiny feature flags library used by AXM companion package examples.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "keywords": [
    "feature-flags",
    "rollout",
    "axm",
    "example"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "axm": {
    "recommendedExtensions": [
      "@examples/packs/npm-javascript-tinyflags@^0.1.0"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
