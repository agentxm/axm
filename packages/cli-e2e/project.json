{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli-e2e",
  "projectType": "application",
  "root": "packages/cli-e2e",
  "sourceRoot": "packages/cli-e2e/src",
  "tags": ["type:e2e", "scope:cli"],
  "targets": {
    "e2e-main": {
      "cache": true,
      "dependsOn": ["cli:build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/cli-e2e"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "packages/cli-e2e"
      }
    },
    "e2e-windows": {
      "cache": true,
      "dependsOn": ["cli:build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/cli-e2e-windows"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.windows.config.ts",
        "cwd": "packages/cli-e2e"
      }
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["cli:compile"],
      "outputs": [
        "{workspaceRoot}/test-results/cli-e2e",
        "{workspaceRoot}/test-results/cli-e2e-binary",
        "{workspaceRoot}/test-results/cli-e2e-install"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/cli-e2e",
        "parallel": false,
        "commands": [
          "pnpm exec vitest run",
          "pnpm exec vitest run --config vitest.binary.config.ts",
          "pnpm exec vitest run --config vitest.install.config.ts"
        ]
      }
    },
    "binary-smoke": {
      "cache": true,
      "dependsOn": ["cli:compile"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/cli-e2e-binary"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.binary.config.ts",
        "cwd": "packages/cli-e2e"
      }
    },
    "binary-smoke-artifact": {
      "dependsOn": ["utils:build"],
      "outputs": ["{workspaceRoot}/test-results/cli-e2e-binary"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.binary.config.ts",
        "cwd": "packages/cli-e2e"
      }
    },
    "install-suite": {
      "dependsOn": ["utils:build", "cli:compile-host"],
      "outputs": ["{workspaceRoot}/test-results/cli-e2e-install"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.install.config.ts",
        "cwd": "packages/cli-e2e"
      }
    },
    "install-verification": {
      "dependsOn": ["utils:build"],
      "outputs": ["{workspaceRoot}/test-results/cli-e2e-install"],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/run-install-verification.ts"],
        "cwd": "packages/cli-e2e"
      }
    }
  }
}
