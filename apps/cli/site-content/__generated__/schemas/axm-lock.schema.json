{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/LockfileEncoded",
  "definitions": {
    "SourceSubPath": { "type": "string", "minLength": 1 },
    "Handle": {
      "type": "string",
      "pattern": "^@[a-z0-9_](?:[a-z0-9_-]*[a-z0-9_])?$",
      "title": "Handle",
      "description": "A unique username or organization name starting with @, like @my-org.",
      "examples": ["@my-org", "@username"]
    },
    "ExtensionName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "title": "Extension Name",
      "description": "The name of an extension — lowercase letters, numbers, and hyphens (e.g. my-skill).",
      "examples": ["my-skill", "code-review", "prettier"]
    },
    "Version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "title": "Version",
      "description": "A semver version like 1.0.0. Ranges are not allowed here.",
      "examples": ["1.0.0", "2.3.1", "0.1.0-beta.1"]
    },
    "TreeIntegrity": { "type": "string" },
    "NonPackExtensionFqn": {
      "type": "string",
      "pattern": "^(@[a-z0-9_](?:[a-z0-9_-]*[a-z0-9_])?)\\/(skills|mcps|subagents|rules|hooks|knowledge)\\/([a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)$",
      "title": "Non-Pack Extension FQN",
      "description": "Extension identifier restricted to non-pack types (skills, mcps, subagents, rules, hooks, knowledge).",
      "examples": ["@acme/skills/code-review", "@my-org/rules/typescript"]
    },
    "VersionRange": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[~^<>=*xXvV0-9A-Za-z+| .-]+$",
      "title": "Version Range",
      "description": "A semver version range like ^1.0.0, ~2.3.0, >=1.0.0 <3.0.0, or an exact version 1.2.3. Use \"*\" to always resolve to the latest available version.",
      "examples": ["^1.0.0", "~2.4", ">=1 <3", "1.2.3", "*"]
    },
    "PackMemberRegistrySource": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["registry"] },
        "url": { "type": "string" }
      },
      "required": ["type", "url"],
      "additionalProperties": false,
      "description": "A self-describing Registry locator for one Pack member."
    },
    "ExplicitRegistryPackMemberConstraint": {
      "type": "object",
      "properties": {
        "source": { "$ref": "#/definitions/PackMemberRegistrySource" },
        "versionRange": { "$ref": "#/definitions/VersionRange" }
      },
      "required": ["source", "versionRange"],
      "additionalProperties": false
    },
    "PackMemberConstraint": {
      "anyOf": [
        { "$ref": "#/definitions/VersionRange" },
        { "$ref": "#/definitions/ExplicitRegistryPackMemberConstraint" }
      ],
      "description": "A version range that inherits the Pack source, or an explicit Registry locator and range."
    },
    "LockfileEncoded": {
      "type": "object",
      "properties": {
        "lockfileVersion": { "type": "number", "enum": [11], "default": 11 },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "source": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "enum": ["git"] },
                      "url": { "type": "string" },
                      "path": { "$ref": "#/definitions/SourceSubPath" },
                      "format": { "type": "string" }
                    },
                    "required": ["type", "url", "path", "format"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "enum": ["registry"] },
                      "url": { "type": "string" },
                      "owner": { "$ref": "#/definitions/Handle" },
                      "extensionType": { "type": "string" },
                      "name": { "$ref": "#/definitions/ExtensionName" }
                    },
                    "required": ["type", "url", "owner", "extensionType", "name"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "enum": ["path"] },
                      "path": { "type": "string", "minLength": 1 },
                      "format": { "type": "string" }
                    },
                    "required": ["type", "path", "format"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "enum": ["http"] },
                      "url": { "type": "string" },
                      "kind": { "type": "string", "enum": ["skill-md", "archive", "index"] },
                      "entry": {
                        "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
                      },
                      "path": { "$ref": "#/definitions/SourceSubPath" },
                      "portable": { "type": "boolean" },
                      "format": { "type": "string" }
                    },
                    "required": ["type", "url", "kind", "path", "portable", "format"],
                    "additionalProperties": false
                  }
                ]
              },
              "resolved": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "commit": { "type": "string", "minLength": 1 },
                      "tree": { "type": "string", "minLength": 1 }
                    },
                    "required": ["commit", "tree"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "version": { "$ref": "#/definitions/Version" },
                      "integrity": {
                        "type": "string",
                        "description": "SRI sha512 of the published archive, verified against downloaded bytes before extraction. The supply-chain guarantee for registry installs; never compared against installed files on disk."
                      },
                      "publisherBindingId": { "type": "string", "minLength": 1 }
                    },
                    "required": ["version", "integrity", "publisherBindingId"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": { "tree": { "$ref": "#/definitions/TreeIntegrity" } },
                    "required": ["tree"],
                    "additionalProperties": false
                  },
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "format": {
                            "type": "string",
                            "enum": ["skill-md", "zip", "tar", "tar.gz"]
                          },
                          "url": { "type": "string" },
                          "digest": { "type": "string" }
                        },
                        "required": ["format", "url", "digest"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "format": { "type": "string", "enum": ["files"] },
                          "files": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "object",
                              "properties": {
                                "path": { "type": "string", "minLength": 1 },
                                "url": { "type": "string" },
                                "digest": { "type": "string" }
                              },
                              "required": ["path", "url", "digest"],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": ["format", "files"],
                        "additionalProperties": false
                      }
                    ]
                  }
                ]
              },
              "treeIntegrity": { "$ref": "#/definitions/TreeIntegrity" }
            },
            "required": ["source", "resolved", "treeIntegrity"],
            "additionalProperties": false
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "identity": {
                "type": "object",
                "properties": {
                  "owner": { "anyOf": [{ "$ref": "#/definitions/Handle" }, { "type": "null" }] },
                  "name": { "$ref": "#/definitions/ExtensionName" }
                },
                "required": ["name"],
                "additionalProperties": false
              },
              "component": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "format": {
                        "type": "string",
                        "enum": ["agent-plugins", "claude", "codex", "cursor"]
                      },
                      "packageRoot": { "type": "string" },
                      "componentPath": { "type": "string" },
                      "manifestPath": { "type": "string" },
                      "marketplace": {
                        "type": "object",
                        "properties": {
                          "path": { "type": "string" },
                          "name": { "type": "string" }
                        },
                        "required": ["path", "name"],
                        "additionalProperties": false
                      }
                    },
                    "required": ["format", "packageRoot", "componentPath"],
                    "additionalProperties": false
                  },
                  { "type": "null" }
                ]
              },
              "revision": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
            },
            "required": ["package", "identity"],
            "additionalProperties": false
          }
        },
        "subagents": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "package": { "type": "string", "minLength": 1 },
                  "identity": {
                    "type": "object",
                    "properties": {
                      "owner": {
                        "anyOf": [{ "$ref": "#/definitions/Handle" }, { "type": "null" }]
                      },
                      "name": { "$ref": "#/definitions/ExtensionName" }
                    },
                    "required": ["name"],
                    "additionalProperties": false
                  },
                  "component": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "format": {
                            "type": "string",
                            "enum": ["agent-plugins", "claude", "codex", "cursor"]
                          },
                          "packageRoot": { "type": "string" },
                          "componentPath": { "type": "string" },
                          "manifestPath": { "type": "string" },
                          "marketplace": {
                            "type": "object",
                            "properties": {
                              "path": { "type": "string" },
                              "name": { "type": "string" }
                            },
                            "required": ["path", "name"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["format", "packageRoot", "componentPath"],
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  },
                  "revision": {
                    "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
                  }
                },
                "required": ["package", "identity"],
                "additionalProperties": false
              }
            },
            { "type": "null" }
          ]
        },
        "mcpServers": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "package": { "type": "string", "minLength": 1 },
                  "identity": {
                    "type": "object",
                    "properties": {
                      "owner": {
                        "anyOf": [{ "$ref": "#/definitions/Handle" }, { "type": "null" }]
                      },
                      "name": { "$ref": "#/definitions/ExtensionName" }
                    },
                    "required": ["name"],
                    "additionalProperties": false
                  },
                  "component": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "format": {
                            "type": "string",
                            "enum": ["agent-plugins", "claude", "codex", "cursor"]
                          },
                          "packageRoot": { "type": "string" },
                          "componentPath": { "type": "string" },
                          "manifestPath": { "type": "string" },
                          "marketplace": {
                            "type": "object",
                            "properties": {
                              "path": { "type": "string" },
                              "name": { "type": "string" }
                            },
                            "required": ["path", "name"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["format", "packageRoot", "componentPath"],
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  },
                  "revision": {
                    "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
                  }
                },
                "required": ["package", "identity"],
                "additionalProperties": false
              }
            },
            { "type": "null" }
          ]
        },
        "rules": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "package": { "type": "string", "minLength": 1 },
                  "identity": {
                    "type": "object",
                    "properties": {
                      "owner": {
                        "anyOf": [{ "$ref": "#/definitions/Handle" }, { "type": "null" }]
                      },
                      "name": { "$ref": "#/definitions/ExtensionName" }
                    },
                    "required": ["name"],
                    "additionalProperties": false
                  },
                  "component": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "format": {
                            "type": "string",
                            "enum": ["agent-plugins", "claude", "codex", "cursor"]
                          },
                          "packageRoot": { "type": "string" },
                          "componentPath": { "type": "string" },
                          "manifestPath": { "type": "string" },
                          "marketplace": {
                            "type": "object",
                            "properties": {
                              "path": { "type": "string" },
                              "name": { "type": "string" }
                            },
                            "required": ["path", "name"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["format", "packageRoot", "componentPath"],
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  },
                  "revision": {
                    "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
                  }
                },
                "required": ["package", "identity"],
                "additionalProperties": false
              }
            },
            { "type": "null" }
          ]
        },
        "hooks": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "package": { "type": "string", "minLength": 1 },
                  "identity": {
                    "type": "object",
                    "properties": {
                      "owner": {
                        "anyOf": [{ "$ref": "#/definitions/Handle" }, { "type": "null" }]
                      },
                      "name": { "$ref": "#/definitions/ExtensionName" }
                    },
                    "required": ["name"],
                    "additionalProperties": false
                  },
                  "component": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "format": {
                            "type": "string",
                            "enum": ["agent-plugins", "claude", "codex", "cursor"]
                          },
                          "packageRoot": { "type": "string" },
                          "componentPath": { "type": "string" },
                          "manifestPath": { "type": "string" },
                          "marketplace": {
                            "type": "object",
                            "properties": {
                              "path": { "type": "string" },
                              "name": { "type": "string" }
                            },
                            "required": ["path", "name"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["format", "packageRoot", "componentPath"],
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  },
                  "revision": {
                    "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
                  }
                },
                "required": ["package", "identity"],
                "additionalProperties": false
              }
            },
            { "type": "null" }
          ]
        },
        "knowledge": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "package": { "type": "string", "minLength": 1 },
                  "identity": {
                    "type": "object",
                    "properties": {
                      "owner": {
                        "anyOf": [{ "$ref": "#/definitions/Handle" }, { "type": "null" }]
                      },
                      "name": { "$ref": "#/definitions/ExtensionName" }
                    },
                    "required": ["name"],
                    "additionalProperties": false
                  },
                  "component": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "format": {
                            "type": "string",
                            "enum": ["agent-plugins", "claude", "codex", "cursor"]
                          },
                          "packageRoot": { "type": "string" },
                          "componentPath": { "type": "string" },
                          "manifestPath": { "type": "string" },
                          "marketplace": {
                            "type": "object",
                            "properties": {
                              "path": { "type": "string" },
                              "name": { "type": "string" }
                            },
                            "required": ["path", "name"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["format", "packageRoot", "componentPath"],
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  },
                  "revision": {
                    "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
                  }
                },
                "required": ["package", "identity"],
                "additionalProperties": false
              }
            },
            { "type": "null" }
          ]
        },
        "packs": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "package": { "type": "string", "minLength": 1 },
                  "identity": {
                    "type": "object",
                    "properties": {
                      "owner": { "$ref": "#/definitions/Handle" },
                      "name": { "$ref": "#/definitions/ExtensionName" }
                    },
                    "required": ["owner", "name"],
                    "additionalProperties": false
                  },
                  "component": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "format": {
                            "type": "string",
                            "enum": ["agent-plugins", "claude", "codex", "cursor"]
                          },
                          "packageRoot": { "type": "string" },
                          "componentPath": { "type": "string" },
                          "manifestPath": { "type": "string" },
                          "marketplace": {
                            "type": "object",
                            "properties": {
                              "path": { "type": "string" },
                              "name": { "type": "string" }
                            },
                            "required": ["path", "name"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["format", "packageRoot", "componentPath"],
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  },
                  "revision": {
                    "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
                  },
                  "sourceRoot": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                  "manifestVersion": { "$ref": "#/definitions/Version" },
                  "manifestContentIdentity": {
                    "type": "string",
                    "description": "Advisory SHA-256 change-detection marker of canonical content at install time. Not a tamper guarantee: installed content is workspace-owned and may be rewritten by content-preserving tools after install."
                  },
                  "dependencies": {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/definitions/PackMemberConstraint" },
                    "propertyNames": { "$ref": "#/definitions/NonPackExtensionFqn" },
                    "description": "Map of fully-qualified non-Pack extension names to inherited ranges or explicit Registry locators. Packs cannot depend on other Packs."
                  }
                },
                "required": [
                  "package",
                  "identity",
                  "manifestVersion",
                  "manifestContentIdentity",
                  "dependencies"
                ],
                "additionalProperties": false
              }
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["lockfileVersion", "packages", "skills"],
      "additionalProperties": false
    }
  }
}
