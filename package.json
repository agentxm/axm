{
  "name": "axm",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "axm": "bun --conditions=axm-source apps/cli/src/main.ts",
    "axm:local": "./scripts/axm-local",
    "classify:ci": "bun scripts/classify-ci-changes.ts",
    "check:ci-image": "node scripts/check-ci-image.mjs",
    "test:report": "pnpm exec nx run axm:test-report",
    "test:report:open": "pnpm exec nx run axm:allure-report-open",
    "sync": "nx sync",
    "sync:check": "nx sync:check",
    "watch": "nx run cli:watch",
    "build": "nx run-many -t build --batch",
    "build:affected": "nx affected -t build --batch",
    "test": "nx run-many -t test",
    "test:affected": "nx affected -t test",
    "test:e2e": "bun scripts/profile-nx.ts e2e run-many -t e2e --nxBail",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:affected": "nx affected -t typecheck",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "format:affected": "nx format:write",
    "format:check:affected": "nx format:check",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "ci": "pnpm run ci:workspace && pnpm run test:e2e",
    "ci:workspace": "pnpm run verify:clean && pnpm run format:check && pnpm run verify:workspace",
    "verify:clean": "pnpm exec nx run axm:source-cli-smoke && pnpm run check:ci-image && pnpm run generate:check && pnpm run sync:check",
    "verify:affected": "bun scripts/profile-nx.ts verify-affected affected -t lint typecheck build test verify-source-hygiene parity-ledger-check lint-bundled-skill --nxBail && bun scripts/profile-nx.ts verify-affected-e2e affected -t e2e --nxBail --parallel=1",
    "verify:workspace": "bun scripts/profile-nx.ts verify-workspace run-many -t lint typecheck build test verify-source-hygiene parity-ledger-check lint-bundled-skill --nxBail",
    "verify:full": "pnpm run verify:workspace && pnpm run test:e2e",
    "container:ci": "bash scripts/container-environment.sh ci",
    "container:smoke": "bash scripts/container-environment.sh smoke",
    "container:build:ci-image": "bash scripts/container-environment.sh build-ci-image",
    "container:smoke:ci-image": "bash scripts/container-environment.sh smoke-ci-image",
    "prepare": "husky && effect-tsgo patch",
    "release:plan": "nx release plan --only-touched=false",
    "release:plan:check": "nx release plan:check",
    "release:prepare": "pnpm exec nx run axm:release-prepare",
    "release:publish": "pnpm exec nx run axm:release-publish",
    "release:publish:local": "pnpm exec nx run axm:release-publish-local",
    "generate": "pnpm exec nx run-many -t generate",
    "generate:check": "bun scripts/generated-output-guard.ts",
    "generate:registry": "pnpm exec nx run registry-client:generate:registry-client",
    "generate:telemetry": "pnpm exec nx run cli:generate:telemetry-client",
    "sync:registry": "pnpm exec nx run registry-client:sync:registry-spec",
    "sync:telemetry": "pnpm exec nx run cli:sync:telemetry-spec",
    "test:spec": "bun --conditions=axm-source scripts/test-spec.ts",
    "test:compatibility": "bun --conditions=axm-source scripts/test-spec.ts --characteristic compatibility",
    "test:performance": "bun --conditions=axm-source scripts/test-spec.ts --characteristic performance",
    "verify:artifact": "bun scripts/verify-artifact.ts",
    "verify:release": "bun scripts/verify-release.ts",
    "verify:deployment": "bun scripts/verify-deployment.ts",
    "bench": "pnpm exec nx run axm:bench",
    "test:all": "pnpm test && pnpm test:e2e",
    "ci:report": "scripts/with-allure-report.sh pnpm run ci",
    "ci:workspace:report": "scripts/with-allure-report.sh pnpm run ci:workspace",
    "verify:affected:report": "scripts/with-allure-report.sh pnpm run verify:affected",
    "test:e2e:report": "scripts/with-allure-report.sh pnpm run test:e2e"
  },
  "nx": {
    "includedScripts": []
  },
  "lint-staged": {
    "{!(.axm|agent_extensions)/**/,}*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{!(.axm|agent_extensions)/**/,}*.{json,md,mdx,yml,yaml,css,scss,html}": "prettier --write"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@agentxm/client-e2e-utils": "workspace:*",
    "@agentxm/extension-model": "workspace:*",
    "@agentxm/extension-workspace": "workspace:*",
    "@agentxm/registry-protocol": "workspace:*",
    "@effect/eslint-plugin": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@eslint/js": "catalog:",
    "@nx/devkit": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@nx/js": "catalog:",
    "@nx/vitest": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@types/bun": "catalog:",
    "@types/semver": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript/native": "catalog:",
    "allure": "catalog:",
    "allure-vitest": "catalog:",
    "effect": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "jsonc-eslint-parser": "catalog:",
    "lint-staged": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
