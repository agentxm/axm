{
  "name": "@agentxm/workspace-reconciliation",
  "version": "0.29.4",
  "description": "Shared desired-state reconciliation planning for AXM workspaces.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "homepage": "https://axm.sh",
  "bugs": {
    "url": "https://github.com/agentxm/axm/issues"
  },
