{
  "name": "axm",
  "private": true,
  "type": "module",
  "scripts": {
    "axm": "bun packages/cli/src/main.ts",
    "axm:local": "AXM_REGISTRY_URL=http://localhost:4300 bun packages/cli/src/main.ts",
    "spike": "bun packages/cli-spike/src/main.ts",
    "watch": "nx run cli:watch",
    "build": "nx run-many -t build",
    "build:affected": "nx affected -t build",
    "test": "nx run-many -t test --nxBail",
    "test:affected": "nx affected -t test --nxBail",
    "test:e2e": "nx run-many -t e2e --nxBail",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:affected": "nx affected -t typecheck",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "verify": "nx format:check && nx run-many -t lint typecheck build test e2e --nxBail --outputStyle=static && nx run scripts:verify-e2e-boundaries",
    "verify:affected": "nx format:check && nx affected -t lint typecheck build test e2e --nxBail --outputStyle=static && nx run scripts:verify-e2e-boundaries",
    "prepare": "husky && effect-language-service patch",
    "release": "bun scripts/release-prepare.ts",
    "release:prepare": "bun scripts/release-prepare.ts",
    "release:publish": "bun scripts/release-publish.ts",
    "generate": "nx run core:generate-registry-client && nx run core:generate-telemetry-client",
    "generate:registry": "nx run core:generate-registry-client",
    "generate:telemetry": "nx run core:generate-telemetry-client"
  },
  "nx": {
    "includedScripts": []
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": "eslint --fix",
    "*.md": "prettier --write"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@axm.sh/utils": "workspace:*",
    "@types/bun": "catalog:",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.84.1",
    "@effect/vitest": "4.0.0-beta.42",
    "@eslint/js": "^10.0.0",
    "@nx/eslint": "22.6.3",
    "@nx/eslint-plugin": "22.6.3",
    "@nx/js": "22.6.3",
    "@nx/vitest": "22.6.3",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nx": "22.6.3",
    "prettier": "^3.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.21.0",
    "vite": "^8.0.0",
    "vitest": "catalog:"
  }
}
