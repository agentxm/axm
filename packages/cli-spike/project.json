{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli-spike",
  "projectType": "application",
  "root": "packages/cli-spike",
  "sourceRoot": "packages/cli-spike/src",
  "tags": ["type:app", "scope:spike"],
  "targets": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "executor": "@nx/js:tsc",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "main": "packages/cli-spike/src/main.ts",
        "outputPath": "packages/cli-spike/dist",
        "tsConfig": "packages/cli-spike/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{ts,tsx,js,mjs,cjs}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "packages/cli-spike"
      }
    },
    "compile": {
      "cache": true,
      "dependsOn": ["build", "^build"],
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/bin"],
      "options": {
        "command": ["bun", "scripts/compile.ts"],
        "cwd": "packages/cli-spike"
      }
    }
  }
}
