{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "version", "agents"],
  "properties": {
    "name": {
      "type": "string",
      "description": "a string matching the pattern ^@[\\w-]+\\/[\\w-]+$",
      "pattern": "^@[\\w-]+\\/[\\w-]+$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "bugs": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
