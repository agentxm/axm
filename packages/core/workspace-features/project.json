{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace-features",
  "projectType": "library",
  "root": "packages/core/workspace-features",
  "sourceRoot": "packages/core/workspace-features/src",
  "tags": ["type:lib", "role:feature", "scope:workspace-features"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/core/workspace-features/src/lifecycle/index.ts",
        "outputPath": "packages/core/workspace-features/dist",
        "tsConfig": "packages/core/workspace-features/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false
      }
    },
    "test": {
      "dependsOn": ["build", "specification-metadata:build"]
    },
    "test:policy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "vitest run --config packages/core/workspace-features/vitest.policy.config.ts",
        "cwd": ".",
        "env": {
          "NODE_OPTIONS": "--conditions=axm-source"
        }
      }
    },
    "test:policy-coverage": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "vitest run --config packages/core/workspace-features/vitest.policy.config.ts --coverage",
        "cwd": ".",
        "env": {
          "NODE_OPTIONS": "--conditions=axm-source"
        }
      }
    },
    "test:policy-mutation": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "stryker run packages/core/workspace-features/stryker.config.json",
        "cwd": ".",
        "env": {
          "NODE_OPTIONS": "--conditions=axm-source",
          "NX_DAEMON": "false",
          "NX_CACHE_DIRECTORY": ".nx/cache",
          "NX_WORKSPACE_DATA_DIRECTORY": ".nx/workspace-data"
        }
      }
    }
  }
}
