{
  "name": "agentxm/example-tinyflags",
  "description": "Tiny feature flags library used by AXM companion package examples.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "feature-flags",
    "rollout",
    "axm",
    "example"
  ],
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "AgentXM\\Examples\\TinyFlags\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AgentXM\\Examples\\TinyFlags\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "axm": {
      "recommendedExtensions": [
        "@examples/packs/php-composer-tinyflags@^0.1.0"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
