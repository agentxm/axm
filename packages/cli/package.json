{
  "name": "axm.sh",
  "version": "0.28.3",
  "description": "Extension manager for AI coding agents \u2014 install skills, subagents, MCP servers, rules, hooks, knowledge, and packs across Claude Code, Codex, Cursor, Copilot, and more.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "homepage": "https://axm.sh",
  "bugs": {
    "url": "https://github.com/agentxm/axm/issues"
  },
  "author": "AgentXM <hello@agentxm.ai> (https://agentxm.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "agent",
    "agents",
    "ai-agent",
    "agent-extensions",
    "agent-skills",
    "extensions",
    "extension-manager",
    "cli",
    "anthropic",
    "mcp",
    "mcp-server",
    "skill",
    "skills",
    "subagent",
    "subagents",
    "pack",
    "claude-code",
    "github-copilot-cli",
    "cursor",
    "gemini-cli",
    "codex",
    "opencode",
    "windsurf",
    "cline",
    "goose",
    "qwen-code"
  ],
  "bin": {
    "axm": "./dist/src/main.js"
  },
  "exports": {
    "./app": {
      "types": "./dist/src/app.d.ts",
      "experimental": "./dist/src/app.js",
      "default": "./dist/src/app.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "experimental": "./dist/src/runtime.js",
      "default": "./dist/src/runtime.js"
    },
    "./specification-harness": {
      "types": "./dist/src/specification-harness.d.ts",
      "experimental": "./dist/src/specification-harness.js",
      "default": "./dist/src/specification-harness.js"
    },
    "./unstable/site-content/schemas/*": "./site-content/__generated__/schemas/*",
    "./unstable/site-content/*": "./site-content/*"
  },
  "files": [
    "dist/src/",
    "!**/*.map",
    "site-content/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "includedScripts": []
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@agentxm/agent-integration": "workspace:^",
    "@agentxm/extension-management": "workspace:^",
    "@agentxm/extension-model": "workspace:^",
    "@agentxm/extension-sources": "workspace:^",
    "@agentxm/extension-workspace": "workspace:^",
    "@agentxm/registry-client": "workspace:^",
    "@agentxm/registry-protocol": "workspace:^",
    "@agentxm/workspace-lint": "workspace:^",
    "@agentxm/workspace-operations": "workspace:^",
    "@agentxm/workspace-state": "workspace:^",
    "@agentxm/workspace-sync": "workspace:^",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "semver": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/semver": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
