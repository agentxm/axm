#!/usr/bin/env bash
set -euo pipefail

# Manage a symlink that exposes a local axm dev build as `axm` on PATH.
# Two modes:
#   link:local  symlink -> scripts/axm-local (bun wrapper, hot reload,
#               registry forced to http://localhost:4300, telemetry off)
#   link        compile a host-only dev binary via nx and symlink to it
#               (uses prod registry defaults; version is suffixed
#                `-dev+<sha>[.dirty]` so telemetry can filter dev builds)
#
# Subcommands:
#   link        compile dev binary and link to it
#   link:local  link to the local bun wrapper
#   unlink      remove the symlink if it points at one of our targets
#   status      print current state and `which -a axm` resolution
#
# Env:
#   AXM_DEV_BIN   target directory for the symlink (default: $HOME/.local/bin)
#   AXM_DEV_NAME  symlink basename (default: axm)
#
# Flags:
#   --force    overwrite an existing entry even if it isn't ours

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"
local_target="${script_dir}/axm-local"
dev_bin_dir="${repo_root}/packages/cli/dist/dev-bin"

bin_dir="${AXM_DEV_BIN:-$HOME/.local/bin}"
link_name="${AXM_DEV_NAME:-axm}"
link_path="${bin_dir}/${link_name}"

force=0
subcommand=""

for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    -h|--help)
      sed -n '3,21p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    link|link:local|unlink|status) subcommand="$arg" ;;
    *)
      echo "axm-link: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$subcommand" ]]; then
  echo "axm-link: missing subcommand (link | link:local | unlink | status)" >&2
  exit 2
fi

resolve_dev_binary_name() {
  local os arch
  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    MINGW*|MSYS*|CYGWIN*) os=windows ;;
    *) echo "axm-link: unsupported OS: $(uname -s)" >&2; exit 1 ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64) arch=x64 ;;
    *) echo "axm-link: unsupported arch: $(uname -m)" >&2; exit 1 ;;
  esac
  if [[ "$os" == "windows" ]]; then
    echo "axm-${os}-${arch}.exe"
  else
    echo "axm-${os}-${arch}"
  fi
}

dev_target="${dev_bin_dir}/$(resolve_dev_binary_name)"

print_resolution() {
  if command -v which >/dev/null 2>&1; then
    echo "PATH resolution:"
    which -a "$link_name" 2>/dev/null | sed 's/^/  /' || true
  fi
}

is_ours() {
  local target="$1"
  [[ "$target" == "$local_target" || "$target" == "$dev_target" ]]
}

mode_label() {
  local target="$1"
  if [[ "$target" == "$local_target" ]]; then
    echo "local (hot)"
  elif [[ "$target" == "$dev_target" ]]; then
    echo "dev-build"
  else
    echo "other ($target)"
  fi
}

create_link() {
  local target="$1"
  mkdir -p "$bin_dir"
  if [[ -L "$link_path" ]]; then
    local current
    current="$(readlink "$link_path")"
    if [[ "$current" == "$target" ]]; then
      echo "Already linked: $link_path -> $current"
      print_resolution
      return 0
    fi
    if is_ours "$current" || [[ $force -ne 0 ]]; then
      rm "$link_path"
    else
      echo "axm-link: $link_path is a symlink to $current; pass --force to replace" >&2
      exit 1
    fi
  elif [[ -e "$link_path" ]]; then
    if [[ $force -eq 0 ]]; then
      echo "axm-link: $link_path exists and is not a symlink; pass --force to replace" >&2
      exit 1
    fi
    rm "$link_path"
  fi
  ln -s "$target" "$link_path"
  echo "Linked [$(mode_label "$target")]: $link_path -> $target"
  case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) echo "Warning: $bin_dir is not on PATH" >&2 ;;
  esac
  print_resolution
}

case "$subcommand" in
  link)
    echo "Compiling dev binary via nx..."
    (cd "$repo_root" && pnpm exec nx run cli:compile-host-dev)
    if [[ ! -x "$dev_target" ]]; then
      echo "axm-link: expected dev binary not found or not executable: $dev_target" >&2
      exit 1
    fi
    create_link "$dev_target"
    ;;
  link:local)
    if [[ ! -x "$local_target" ]]; then
      echo "axm-link: local wrapper not executable: $local_target" >&2
      exit 1
    fi
    create_link "$local_target"
    ;;
  unlink)
    if [[ ! -L "$link_path" ]]; then
      echo "Not linked: $link_path"
      exit 0
    fi
    current="$(readlink "$link_path")"
    if ! is_ours "$current" && [[ $force -eq 0 ]]; then
      echo "axm-link: $link_path -> $current is not our symlink; pass --force to remove" >&2
      exit 1
    fi
    rm "$link_path"
    echo "Unlinked: $link_path"
    print_resolution
    ;;
  status)
    echo "Local target:  $local_target"
    echo "Dev target:    $dev_target"
    echo "Link path:     $link_path"
    if [[ -L "$link_path" ]]; then
      current="$(readlink "$link_path")"
      echo "State:         linked [$(mode_label "$current")]"
    elif [[ -e "$link_path" ]]; then
      echo "State:         exists, not a symlink"
    else
      echo "State:         absent"
    fi
    print_resolution
    ;;
esac
