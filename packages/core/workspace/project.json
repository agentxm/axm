{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace",
  "projectType": "library",
  "root": "packages/core/workspace",
  "sourceRoot": "packages/core/workspace/src",
  "tags": ["type:lib", "role:capability", "scope:workspace"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/core/workspace/src/desired-state/index.ts",
        "outputPath": "packages/core/workspace/dist",
        "tsConfig": "packages/core/workspace/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false
      }
    },
    "test": {
      "dependsOn": ["build", "specification-metadata:build"]
    },
    "test-windows": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/workspace-windows"],
      "options": {
        "command": "pnpm exec vitest run --config vitest.windows.config.ts",
        "cwd": "packages/core/workspace"
      }
    },
    "test:policy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "vitest run --config packages/core/workspace/vitest.policy.config.ts",
        "cwd": ".",
        "env": {
          "NODE_OPTIONS": "--conditions=axm-source"
        }
      }
    },
    "test:policy-coverage": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "vitest run --config packages/core/workspace/vitest.policy.config.ts --coverage",
        "cwd": ".",
        "env": {
          "NODE_OPTIONS": "--conditions=axm-source"
        }
      }
    },
    "test:policy-mutation": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "stryker run packages/core/workspace/stryker.config.json",
        "cwd": ".",
        "env": {
          "NODE_OPTIONS": "--conditions=axm-source",
          "NX_DAEMON": "false",
          "NX_CACHE_DIRECTORY": ".nx/cache",
          "NX_WORKSPACE_DATA_DIRECTORY": ".nx/workspace-data"
        }
      }
    }
  }
}
