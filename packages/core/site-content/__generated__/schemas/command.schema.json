{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CommandManifest",
  "definitions": {
    "Handle": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^@[a-z0-9_](?:[a-z0-9_-]*[a-z0-9_])?$",
          "title": "Handle",
          "description": "A unique username or organization name starting with @, like @my-org.",
          "examples": ["@my-org", "@username"]
        }
      ]
    },
    "ExactSemverVersion": {
      "type": "string"
    },
    "Author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["name"],
      "additionalProperties": false,
      "title": "Author",
      "description": "Author details: name, email, and URL."
    },
    "PackageUrlParts": {
      "type": "string"
    },
    "ExtensionName": {
      "type": "string"
    },
    "CommandManifest": {
      "type": "object",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "$ref": "#/definitions/Handle"
        },
        "version": {
          "$ref": "#/definitions/ExactSemverVersion"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "keywords": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "homepage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bugs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "authors": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Author"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "compatiblePackages": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PackageUrlParts"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": ["command"]
        },
        "name": {
          "$ref": "#/definitions/ExtensionName"
        },
        "agents": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PackageUrlParts"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "agentOverrides": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["owner", "version", "type", "name"],
      "additionalProperties": false,
      "title": "Command Manifest",
      "description": "Configuration file (command.json) that defines a CLI command extension."
    }
  }
}
