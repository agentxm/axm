{
  "name": "axm",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "axm": "bun packages/cli/src/main.ts",
    "axm:local": "./scripts/axm-local",
    "axm:link": "./scripts/axm-link link",
    "axm:link:local": "./scripts/axm-link link:local",
    "axm:link:status": "./scripts/axm-link status",
    "axm:unlink": "./scripts/axm-link unlink",
    "release-prepare": "bun scripts/release-prepare.ts",
    "release-publish": "bun scripts/release-publish.ts",
    "release-publish-local": "bun scripts/release-publish-local.ts",
    "validate-release-tag": "bun scripts/validate-release-tag.ts",
    "resolve-release-meta": "bun scripts/resolve-release-meta.ts",
    "download-ci-binaries": "bun scripts/download-ci-binaries.ts",
    "generate-release-checksums": "bun scripts/release-checksums.ts generate",
    "validate-release-assets": "bash scripts/validate-release-assets.sh",
    "update-homebrew-formula": "bash scripts/update-homebrew-formula.sh",
    "verify-source-hygiene": "bun scripts/verify-source-hygiene.ts",
    "parity-ledger-check": "bun scripts/parity-ledger-check.ts",
    "gen-stack:check": "./scripts/gen-stack-check",
    "classify:ci": "bun scripts/classify-ci-changes.ts",
    "check:ci-image": "node scripts/check-ci-image.mjs",
    "generate-registry": "pnpm exec nx run core:generate:registry-client --outputStyle=static",
    "generate-telemetry": "pnpm exec nx run core:generate:telemetry-client --outputStyle=static",
    "sync-registry-spec": "pnpm exec nx run core:sync:registry-spec --outputStyle=static",
    "sync-telemetry-spec": "pnpm exec nx run core:sync:telemetry-spec --outputStyle=static",
    "test:report": "pnpm exec nx run axm:test-report --outputStyle=static",
    "test:report:generate": "pnpm exec nx run axm:allure-report --outputStyle=static",
    "test:report:open": "pnpm exec nx run axm:allure-report-open --outputStyle=static",
    "scripts-lint": "eslint \"scripts/**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs}\"",
    "scripts-lint:fix": "eslint \"scripts/**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs}\" --fix",
    "scripts-typecheck": "tsc -p scripts/tsconfig.json --noEmit",
    "scripts-test": "pnpm exec vitest run --config scripts/vitest.config.ts",
    "sync": "nx sync",
    "sync:check": "nx sync:check",
    "watch": "nx run cli:watch",
    "build": "nx run-many -t build --batch",
    "build:affected": "nx affected -t build --batch",
    "test": "nx run-many -t test --nxBail && pnpm exec nx run axm:scripts-test --outputStyle=static",
    "test:affected": "nx affected -t test --nxBail && pnpm exec nx run axm:scripts-test --outputStyle=static",
    "test:e2e": "nx run-many -t e2e --nxBail",
    "typecheck": "nx run-many -t typecheck && pnpm exec nx run axm:scripts-typecheck --outputStyle=static",
    "typecheck:affected": "nx affected -t typecheck && pnpm exec nx run axm:scripts-typecheck --outputStyle=static",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "format:affected": "nx format:write",
    "format:check:affected": "nx format:check",
    "lint": "nx run-many -t lint && pnpm exec nx run axm:scripts-lint --outputStyle=static",
    "lint:affected": "nx affected -t lint && pnpm exec nx run axm:scripts-lint --outputStyle=static",
    "lint:fix": "nx run-many -t lint --fix && pnpm scripts-lint:fix",
    "ci": "pnpm run verify:clean && pnpm run format:check && pnpm run verify:full",
    "verify:clean": "pnpm run check:ci-image && pnpm run generate:check && pnpm run sync:check",
    "verify:affected": "pnpm exec nx affected -t lint typecheck build test scripts-lint scripts-typecheck scripts-test verify-source-hygiene parity-ledger-check --batch --nxBail --outputStyle=static && pnpm exec nx affected -t e2e --batch --nxBail --parallel=1 --outputStyle=static",
    "verify:full": "pnpm exec nx run-many -t lint typecheck build test scripts-lint scripts-typecheck scripts-test verify-source-hygiene parity-ledger-check --batch --nxBail --outputStyle=static && pnpm exec nx run-many -t e2e --batch --nxBail --parallel=1 --outputStyle=static",
    "container:ci": "bash scripts/container-environment.sh ci",
    "container:smoke": "bash scripts/container-environment.sh smoke",
    "container:build:ci-image": "bash scripts/container-environment.sh build-ci-image",
    "container:smoke:ci-image": "bash scripts/container-environment.sh smoke-ci-image",
    "prepare": "husky && effect-tsgo patch",
    "release:plan": "nx release plan --only-touched=false",
    "release:plan:check": "nx release plan:check",
    "release:prepare": "pnpm exec nx run axm:release-prepare --outputStyle=static",
    "release:publish": "pnpm exec nx run axm:release-publish --outputStyle=static",
    "release:publish:local": "pnpm exec nx run axm:release-publish-local --outputStyle=static",
    "generate": "pnpm exec nx run-many -t generate --outputStyle=static",
    "generate:check": "pnpm exec nx run-many -t generate --skip-nx-cache --outputStyle=static && git diff --exit-code",
    "generate:registry": "pnpm exec nx run core:generate:registry-client --outputStyle=static",
    "generate:telemetry": "pnpm exec nx run core:generate:telemetry-client --outputStyle=static",
    "sync:registry": "pnpm exec nx run core:sync:registry-spec --outputStyle=static",
    "sync:telemetry": "pnpm exec nx run core:sync:telemetry-spec --outputStyle=static",
    "test:spec": "bun scripts/test-spec.ts",
    "test:internal": "nx run-many -t test --exclude specifications --nxBail",
    "test:tooling": "pnpm exec nx run axm:scripts-test --outputStyle=static",
    "test:compatibility": "bun scripts/test-spec.ts --class compatibility",
    "test:performance": "bun scripts/test-spec.ts --class performance",
    "verify:artifact": "bun scripts/verify-artifact.ts",
    "verify:release": "bun scripts/verify-release.ts",
    "verify:deployment": "bun scripts/verify-deployment.ts",
    "bench": "bun scripts/bench.ts",
    "test:all": "pnpm test && pnpm test:e2e"
  },
  "nx": {
    "includedScripts": []
  },
  "lint-staged": {
    "{!(.axm|agent_extensions)/**/,}*.{js,ts,mjs,cjs}": "eslint --fix",
    "{!(.axm|agent_extensions)/**/,}*.{md,json,jsonc,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@agentxm/client-core": "workspace:*",
    "@agentxm/client-utils": "workspace:*",
    "@effect/eslint-plugin": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@eslint/js": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@nx/js": "catalog:",
    "@nx/vitest": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@types/bun": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript/native": "catalog:",
    "allure": "catalog:",
    "allure-vitest": "catalog:",
    "effect": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
