{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli",
  "projectType": "application",
  "root": "packages/cli",
  "sourceRoot": "packages/cli/src",
  "tags": ["type:app", "scope:cli"],
  "targets": {
    "build": {
      "cache": true,
      "dependsOn": ["generate", "^build"],
      "executor": "@nx/js:tsc",
      "inputs": [
        "production",
        "{projectRoot}/help/topics/*.md",
        "{workspaceRoot}/skills/axm/skill.json",
        "{workspaceRoot}/skills/axm/src/**/*",
        "^production"
      ],
      "outputs": ["{projectRoot}/dist/src", "{projectRoot}/dist/tsconfig.tsbuildinfo"],
      "options": {
        "main": "packages/cli/src/main.ts",
        "outputPath": "packages/cli/dist",
        "tsConfig": "packages/cli/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false
      }
    },
    "watch": {
      "cache": false,
      "dependsOn": ["^build"],
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/cli/src/main.ts",
        "outputPath": "packages/cli/dist",
        "tsConfig": "packages/cli/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false,
        "watch": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": ["generate"],
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{ts,tsx,js,mjs,cjs}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "packages/cli"
      }
    },
    "generate": {
      "dependsOn": [
        "generate:type-enumerations",
        "generate:help-topics",
        "generate:bundled-axm-skill",
        "generate:schemas"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "echo cli generated output is up to date"
      }
    },
    "generate:type-enumerations": {
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/generate-type-enumerations.ts",
        "{projectRoot}/scripts/type-enumerations.ts",
        "{workspaceRoot}/packages/extension-model/src/unstable/extensions/common.ts",
        "{workspaceRoot}/packages/extension-model/src/unstable/extension-types/catalog.ts",
        "{workspaceRoot}/packages/extension-model/src/unstable/extension-types/schema.ts",
        "{workspaceRoot}/packages/extension-model/src/unstable/extension-types/standards.ts",
        "{workspaceRoot}/.prettierrc.json",
        "{workspaceRoot}/README.md",
        "{projectRoot}/README.md",
        "{projectRoot}/help/topics/getting-started.md",
        "{projectRoot}/help/topics/basic-usage.md"
      ],
      "outputs": [
        "{workspaceRoot}/README.md",
        "{projectRoot}/README.md",
        "{projectRoot}/help/topics/getting-started.md",
        "{projectRoot}/help/topics/basic-usage.md"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/generate-type-enumerations.ts"],
        "cwd": "packages/cli"
      },
      "dependsOn": [
        "extension-model:build",
        "registry-protocol:build",
        "extension-management:build"
      ]
    },
    "generate:help-topics": {
      "cache": true,
      "dependsOn": [
        "generate:type-enumerations",
        {
          "projects": ["cli"],
          "target": "generate:schemas"
        },
        "extension-model:build",
        "registry-protocol:build",
        "extension-management:build"
      ],
      "inputs": [
        "{projectRoot}/help/topics/*.md",
        "{projectRoot}/scripts/generate-help-topics.ts",
        "{projectRoot}/scripts/type-enumerations.ts",
        "{workspaceRoot}/packages/cli/site-content/__generated__/schemas/*.schema.json",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": ["{projectRoot}/src/__generated__/help-topics.ts"],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/generate-help-topics.ts"],
        "cwd": "packages/cli"
      }
    },
    "generate:bundled-axm-skill": {
      "cache": true,
      "dependsOn": [
        {
          "projects": ["extension-management"],
          "target": "build"
        },
        "extension-model:build",
        "registry-protocol:build",
        "extension-management:build"
      ],
      "inputs": [
        "{projectRoot}/scripts/bundled-axm-skill-contract.ts",
        "{projectRoot}/scripts/generate-bundled-axm-skill.ts",
        "{workspaceRoot}/packages/extension-management/src/unstable/skills/axm-skill-compatibility.ts",
        "{workspaceRoot}/packages/registry-protocol/src/unstable/content/skill-content.ts",
        "{workspaceRoot}/skills/axm/skill.json",
        "{workspaceRoot}/skills/axm/src/**/*"
      ],
      "outputs": ["{projectRoot}/src/__generated__/bundled-axm-skill.ts"],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/generate-bundled-axm-skill.ts"],
        "cwd": "packages/cli"
      }
    },
    "compile": {
      "cache": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/bin"],
      "options": {
        "command": ["bun", "scripts/compile.ts"],
        "cwd": "packages/cli"
      }
    },
    "compile-host": {
      "cache": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/host-bin"],
      "options": {
        "command": ["bun", "scripts/compile.ts", "--host-only"],
        "cwd": "packages/cli"
      }
    },
    "compile-host-dev": {
      "cache": false,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/dev-bin"],
      "options": {
        "command": ["bun", "scripts/compile.ts", "--host-only", "--dev-build"],
        "cwd": "packages/cli"
      }
    },
    "nx-release-publish": {
      "cache": false,
      "dependsOn": ["build", "^nx-release-publish"],
      "executor": "@nx/js:release-publish"
    },
    "generate:schemas": {
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/scripts/generate-schemas.ts",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": ["{projectRoot}/site-content/__generated__/schemas"],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/generate-schemas.ts"],
        "cwd": "packages/cli"
      },
      "dependsOn": ["extension-management:build", "^build"]
    }
  }
}
