{
  "name": "axm",
  "private": true,
  "type": "module",
  "scripts": {
    "axm": "bun packages/cli/src/main.ts",
    "axm:local": "AXM_REGISTRY_URL=http://localhost:4300 bun packages/cli/src/main.ts",
    "axm-dev": "bun packages/cli/src/dev-main.ts",
    "spike": "pnpm --filter @axm.sh/cli-spike spike",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @axm.sh/cli run test:e2e",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky && effect-language-service patch",
    "release:patch": "pnpm --filter @axm.sh/core exec npm version patch --no-git-tag-version && pnpm --filter @axm.sh/cli exec npm version patch --no-git-tag-version && pnpm build && pnpm --filter ./packages/core publish --access public --no-git-checks && pnpm --filter ./packages/cli publish --access public --no-git-checks"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": "eslint --fix",
    "*.md": "prettier --write"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.82.0",
    "@effect/vitest": "4.0.0-beta.37",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.21.0",
    "vitest": "catalog:"
  }
}
