{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentxm.dev/schemas/agent-skill-evaluator/summary-1.0.0.json",
  "title": "Agent Skill evaluation summary",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "counts",
    "estimand",
    "case_rates",
    "coverage",
    "routing_case_rates",
    "critical_failure",
    "critical_failures",
    "conclusion",
    "claim_scope",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string" },
    "counts": { "type": "object" },
    "estimand": { "type": "object" },
    "case_rates": { "type": "array" },
    "coverage": { "type": "object" },
    "routing_case_rates": { "type": "array" },
    "critical_failure": { "type": "boolean" },
    "critical_failures": { "type": "array", "items": { "type": "object" } },
    "conclusion": { "enum": ["Supported", "Partially supported", "Unsupported", "Inconclusive"] },
    "claim_scope": { "enum": ["full-suite", "selected-cases"] },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
