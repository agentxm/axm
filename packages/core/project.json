{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "core",
  "projectType": "library",
  "root": "packages/core",
  "sourceRoot": "packages/core/src",
  "tags": ["type:lib", "scope:core"],
  "targets": {
    "generate": {
      "dependsOn": [
        "generate:schemas",
        "generate:agent-catalog",
        "generate:registry-client",
        "generate:telemetry-client"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "echo core generated output is up to date"
      }
    },
    "generate:schemas": {
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/packages/cli/scripts/generate-schemas.ts",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": ["{projectRoot}/site-content/__generated__/schemas"],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "../cli/scripts/generate-schemas.ts"],
        "cwd": "packages/core"
      }
    },
    "generate:agent-catalog": {
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/packages/cli/scripts/generate-agent-catalog.ts",
        "{projectRoot}/src/unstable/agent-capabilities/data/agents/*.yaml",
        "{projectRoot}/src/unstable/agent-capabilities/schema.ts",
        "{projectRoot}/src/unstable/agent-capabilities/validate.ts",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": [
        "{projectRoot}/src/unstable/agent-capabilities/__generated__/catalog.ts",
        "{projectRoot}/src/unstable/agent-capabilities/__generated__/agent.schema.json"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "../cli/scripts/generate-agent-catalog.ts"],
        "cwd": "packages/core"
      }
    },
    "generate:registry-client": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/generate-registry-client.ts",
        "{projectRoot}/specs/registry-openapi.json",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": ["{projectRoot}/src/unstable/registry/__generated__/registry-client.ts"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/generate-registry-client.ts"
      }
    },
    "generate:telemetry-client": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/generate-telemetry-client.ts",
        "{projectRoot}/specs/telemetry-openapi.json",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": ["{projectRoot}/src/unstable/telemetry/__generated__/telemetry-client.ts"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/generate-telemetry-client.ts"
      }
    },
    "sync:registry-spec": {
      "cache": false,
      "inputs": ["{workspaceRoot}/scripts/sync-registry-spec.ts"],
      "outputs": ["{projectRoot}/specs/registry-openapi.json"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/sync-registry-spec.ts"
      }
    },
    "sync:telemetry-spec": {
      "cache": false,
      "inputs": ["{workspaceRoot}/scripts/sync-telemetry-spec.ts"],
      "outputs": ["{projectRoot}/specs/telemetry-openapi.json"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/sync-telemetry-spec.ts"
      }
    },
    "build": {
      "cache": true,
      "dependsOn": ["generate", "^build"],
      "executor": "@nx/js:tsc",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "main": "packages/core/src/unstable/app-error/index.ts",
        "outputPath": "packages/core/dist",
        "tsConfig": "packages/core/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": ["generate"],
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{ts,tsx,js,mjs,cjs}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "packages/core"
      }
    },
    "nx-release-publish": {
      "cache": false,
      "dependsOn": ["build", "^nx-release-publish"],
      "executor": "@nx/js:release-publish"
    }
  }
}
