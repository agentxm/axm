{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentxm.dev/schemas/agent-skill-evaluator/adapter-capabilities-1.0.0.json",
  "title": "Agent Skill evaluator adapter capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter", "protocol_versions", "operations", "stages", "routing_mode", "sandbox_modes", "sandbox_status", "enforced_budgets", "evidence", "network", "credential_isolation", "lifecycle"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "host_cli": { "type": ["string", "null"] }
      }
    },
    "protocol_versions": { "type": "array", "contains": { "const": "1.0.0" } },
    "operations": { "type": "array", "items": { "enum": ["trial", "grade"] }, "uniqueItems": true },
    "stages": { "type": "array", "items": { "enum": ["routing", "execution"] }, "uniqueItems": true },
    "routing_mode": { "enum": ["native-routing", "host-simulated-routing", "catalog-classification-proxy", "unsupported"] },
    "sandbox_modes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sandbox_status": { "enum": ["declared", "observed", "verified", "enforced"] },
    "enforced_budgets": { "type": "array", "items": { "enum": ["wall-clock", "output-bytes", "invocations", "tokens", "cost"] }, "uniqueItems": true },
    "evidence": { "type": "array", "items": { "enum": ["response", "transcript", "artifacts", "filesystem", "subprocess", "network", "tool-calls", "usage"] }, "uniqueItems": true },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status"],
      "properties": {
        "mode": { "enum": ["denied", "allowlist", "unobserved"] },
        "status": { "enum": ["declared", "observed", "verified", "enforced"] }
      }
    },
    "credential_isolation": { "enum": ["verified", "declared", "not-verified"] },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancellation", "retry", "resume"],
      "properties": {
        "cancellation": { "enum": ["process-tree-signal", "adapter-owned", "unsupported"] },
        "retry": { "enum": ["runner-reinvocation", "adapter-owned", "unsupported"] },
        "resume": { "enum": ["stateless", "adapter-checkpoint", "unsupported"] }
      }
    }
  }
}
