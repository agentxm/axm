{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "specifications",
  "projectType": "library",
  "root": "specifications",
  "sourceRoot": "specifications",
  "tags": ["type:specification", "scope:specifications"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{workspaceRoot}/scripts/specification-catalog.ts",
        "{workspaceRoot}/scripts/specification-catalog-lib.ts",
        "{workspaceRoot}/packages/cli-e2e/src/**/*.ts"
      ],
      "outputs": ["{projectRoot}/catalog.md"],
      "options": {
        "command": "bun scripts/specification-catalog.ts",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{ts,tsx,js,mjs,cjs}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "specifications"
      }
    }
  }
}
