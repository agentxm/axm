{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentxm.dev/schemas/agent-skill-evaluator/artifact-1.0.0.json",
  "title": "Agent Skill evaluation artifact observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "change", "size_bytes", "content", "truncated", "binary"],
  "properties": {
    "path": { "type": "string" },
    "change": { "enum": ["created", "modified", "deleted"] },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "content": { "type": ["string", "null"] },
    "truncated": { "type": "boolean" },
    "binary": { "type": "boolean" }
  }
}
