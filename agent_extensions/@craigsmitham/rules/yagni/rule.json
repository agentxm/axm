{
  "$schema": "https://axm.sh/schemas/rule.schema.json",
  "owner": "@craigsmitham",
  "name": "yagni",
  "version": "0.1.1",
  "type": "rule",
  "title": "YAGNI",
  "priority": 100,
  "description": "Prompts agents to defer speculative capability, structure, process, and scope until a current need justifies commitment, while preserving cheap options that would be costly to recover",
  "keywords": [
    "yagni",
    "simple-design",
    "incremental-design",
    "speculative-complexity",
    "optionality",
    "scope-control"
  ],
  "standalone": false,
  "recommendedPacks": ["@craigsmitham/packs/software-engineering"],
  "repository": {
    "type": "git",
    "url": "https://github.com/craigsmitham/agent-extensions",
    "directory": ".axm/extensions/@craigsmitham/rules/yagni"
  },
  "homepage": "https://github.com/craigsmitham/agent-extensions",
  "license": "MIT"
}
