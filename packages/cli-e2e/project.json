{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli-e2e",
  "projectType": "application",
  "root": "packages/cli-e2e",
  "sourceRoot": "packages/cli-e2e/src",
  "tags": ["type:e2e", "scope:cli"],
  "targets": {
    "e2e": {
      "dependsOn": ["cli:build"],
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "packages/cli-e2e/vitest.config.ts"
      }
    },
    "binary-smoke": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "packages/cli-e2e/vitest.binary.config.ts"
      }
    },
    "install-verification": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "packages/cli-e2e/vitest.install.config.ts"
      }
    }
  }
}
