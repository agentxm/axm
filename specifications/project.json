{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "specifications",
  "projectType": "library",
  "root": "specifications",
  "sourceRoot": "specifications",
  "tags": ["type:specification", "scope:specifications"],
  "targets": {
    "test": {
      "dependsOn": ["^build"]
    },
    "test-memory": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/vitest.reporting.ts",
        "{workspaceRoot}/scripts/specification-evidence-reporter.ts",
        { "externalDependencies": ["vitest"] },
        { "env": "CI" }
      ],
      "outputs": ["{workspaceRoot}/test-results/specifications-memory"],
      "options": {
        "command": "vitest run --config vitest.memory.config.ts",
        "cwd": "specifications"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{workspaceRoot}/scripts/specification-catalog.ts",
        "{workspaceRoot}/scripts/specification-catalog-lib.ts",
        "{workspaceRoot}/packages/cli-e2e/src/**/*.ts",
        "{workspaceRoot}/packages/extension-model/src/unstable/specifications/**/*.ts"
      ],
      "outputs": ["{projectRoot}/catalog.md"],
      "options": {
        "command": "bun --conditions=axm-source scripts/specification-catalog.ts",
        "cwd": "."
      }
    }
  }
}
