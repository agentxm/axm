cabal-version:      2.4
name:               agentxm-example-pawmatch
version:            0.1.0.0
synopsis:           Tiny community pet-adoption CLI demonstrating consumption of agentxm-example-tinyflags.
description:
  Reference Haskell consumer of the agentxm-example-tinyflags library.
  Not publishable — exists to demonstrate consumption.

license:            MIT
license-file:       LICENSE
author:             AgentXM
maintainer:         noreply@agentxm.ai
homepage:           https://github.com/agentxm/axm
bug-reports:        https://github.com/agentxm/axm/issues
copyright:          2026 AgentXM
category:           Development
build-type:         Simple
tested-with:        GHC ==9.6.3
extra-source-files: README.md

-- AXM package-author metadata. Reads as a flat `x-axm-<field>` line; the
-- value is JSON-decoded into AxmPackageMeta. This app links a single
-- standalone skill — see ./.axm/extensions/@examples/skills/.
x-axm-recommendedExtensions: ["@examples/skills/haskell-hackage-pawmatch-find-a-pet@^0.1.0"]

source-repository head
    type:     git
    location: https://github.com/agentxm/axm

library
    exposed-modules:
        AgentXM.Example.PawMatch
        AgentXM.Example.PawMatch.Cli
        AgentXM.Example.PawMatch.Charities
        AgentXM.Example.PawMatch.Flags
        AgentXM.Example.PawMatch.Pets
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns
                      -Wincomplete-record-updates -Wpartial-fields
                      -Wredundant-constraints
    build-depends:
        base                       >= 4.14 && < 5
      , agentxm-example-tinyflags  >= 0.1  && < 0.2
      , optparse-applicative       >= 0.17 && < 0.19
      , text                       >= 1.2  && < 3.0

executable pawmatch
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base                       >= 4.14 && < 5
      , agentxm-example-pawmatch

test-suite pawmatch-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    default-language: Haskell2010
    ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base                       >= 4.14 && < 5
      , agentxm-example-pawmatch
      , hspec                      >= 2.7  && < 3.0
