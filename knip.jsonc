{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "treatConfigHintsAsErrors": true,
  // Gate files, dependency declarations, and unused exports. Member pruning is
  // reviewed separately; --include can select that report.
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "unresolved",
    "catalog",
    "catalogReferences",
    "binaries",
    "exports",
    "types",
  ],
  // Private packages are internal, so their entry exports must be used too. The
  // published packages turn this off below: their entry points are public API.
  // An export that only something knip cannot trace consumes, such as a type
  // dependents name in emitted declarations or a configuration file another
  // tool loads, carries a @public tag.
  "includeEntryExports": true,
  // Generated clients mirror their contracts whole.
  "ignoreIssues": {
    "apps/cli/src/telemetry/__generated__/**": ["exports", "types"],
    "packages/supporting/registry-client/src/__generated__/**": ["exports", "types"],
    // Type tests export their compile-time assertions so the compiler checks
    // them without reporting unused locals; nothing imports them.
    "**/*.type-test.ts": ["exports", "types"],
    // lint-staged loads this default export. The file belongs to the staged-check
    // template other workspaces copy unchanged, so it carries no knip tag.
    "scripts/check-staged.config.mjs": ["exports"],
  },
  // Nx infers each project's compiler target; the dual compiler aliases are
  // enforced separately by scripts/typescript-aliases.test.ts.
  // The Git bootstrap enters lint-staged through its installed Node binary
  // before pnpm can parse unstaged manifests.
  "ignoreDependencies": ["@typescript/native", "lint-staged"],
  "vitest": {
    "config": [
      "vitest*.config.{js,mjs,ts,cjs,mts,cts}",
      "vitest.{workspace,projects}.{js,mjs,ts,cjs,mts,cts,json}",
    ],
  },
  "workspaces": {
    ".": {
      // @nx/eslint-plugin loads this recommended configuration at runtime but
      // omits it from its own dependency metadata.
      "ignoreDependencies": ["@eslint/js"],
      // Native toolchain manager; scanner versions are declared in mise.toml,
      // independently of npm dependency ownership.
      "ignoreBinaries": ["mise"],
      // These are loaded indirectly by Allure, shell launchers, benchmark child
      // processes, and specification discovery.
      "entry": [
        "scripts/check-staged.config.mjs",
        "allurerc.ts",
        "benchmarks/lifecycle-preload.cjs",
        "scripts/axm-local.ts",
        "specifications/product-goals.ts",
        "tools/architecture/check.mjs",
        "tools/architecture/*.test.mjs",
      ],
      // Acquired Agent Skills and their evaluation fixtures have a separate owner.
      "project": [
        "*.{ts,mts,cts,js,mjs,cjs}",
        "{scripts,benchmarks,specifications,tools/architecture}/**/*.{ts,mts,cts,js,mjs,cjs}",
      ],
      "vitest": {
        "config": ["vitest*.config.ts", "scripts/vitest.config.ts"],
      },
    },
    "packages/core/extension-model": {
      "includeEntryExports": false,
      "entry": ["src/**/*.type-test.ts"],
    },
    "packages/core/extension-content": {
      "includeEntryExports": false,
    },
    "packages/core/registry-protocol": {
      "includeEntryExports": false,
    },
    "tools/specification-metadata": {
      "includeEntryExports": false,
    },
    "packages/core/workspace-features": {
      "entry": ["src/**/*.type-test.ts"],
    },
    "packages/core/workspace-kernel": {
      "entry": ["src/**/*.type-test.ts"],
    },
    "apps/cli": {
      "includeEntryExports": false,
      // Explicit roots for source-conditioned Bun launchers.
      "entry": [
        "src/main.ts",
        "scripts/generate-agent-catalog.ts",
        "scripts/generate-cli-reference.ts",
        "scripts/generate-schemas.ts",
        "scripts/generate-type-enumerations.ts",
        "scripts/paint-gallery.ts",
      ],
      // Pin the published Effect runtime cohort despite its transitive import.
      "ignoreDependencies": ["@effect/platform-node-shared"],
    },
    "tools/extension-type-parity": {
      "entry": ["scripts/generate-e2e-extension-matrix.ts"],
    },
  },
}
