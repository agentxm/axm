{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "core",
  "projectType": "library",
  "root": "packages/core",
  "sourceRoot": "packages/core/src",
  "tags": ["type:lib", "scope:core"],
  "targets": {
    "generate-schemas": {
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/packages/cli/scripts/generate-schemas.ts",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": ["{projectRoot}/site-content/__generated__/schemas"],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "../cli/scripts/generate-schemas.ts"],
        "cwd": "packages/core"
      }
    },
    "generate-agent-catalog": {
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/packages/cli/scripts/generate-agent-catalog.ts",
        "{projectRoot}/src/unstable/agent-capabilities/data/agents/*.yaml",
        "{projectRoot}/src/unstable/agent-capabilities/schema.ts",
        "{projectRoot}/src/unstable/agent-capabilities/validate.ts",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": [
        "{projectRoot}/src/unstable/agent-capabilities/catalog.generated.ts",
        "{projectRoot}/src/unstable/agent-capabilities/agent.schema.json"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "../cli/scripts/generate-agent-catalog.ts"],
        "cwd": "packages/core"
      }
    },
    "build": {
      "cache": true,
      "dependsOn": ["generate-agent-catalog", "generate-schemas", "^build"],
      "executor": "@nx/js:tsc",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "main": "packages/core/src/unstable/app-error/index.ts",
        "outputPath": "packages/core/dist",
        "tsConfig": "packages/core/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{ts,tsx,js,mjs,cjs}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "packages/core"
      }
    },
    "nx-release-publish": {
      "cache": false,
      "dependsOn": ["build", "^nx-release-publish"],
      "executor": "@nx/js:release-publish"
    }
  }
}
