opam-version: "2.0"
name: "agentxm-example-pawmatch"
version: "0.1.0"
synopsis: "Tiny community pet-adoption CLI demonstrating consumption of agentxm-example-tinyflags."
description: """
Reference OCaml consumer of the agentxm-example-tinyflags opam package. Not
publishable to opam-repository — it exists to demonstrate consumption of a
TinyFlags-backed library and to host a companion AXM skill (`find-a-pet`)
under .axm/extensions/.
"""
maintainer: "AgentXM <noreply@agentxm.ai>"
authors: ["AgentXM"]
license: "MIT"
homepage: "https://github.com/agentxm/axm-b"
bug-reports: "https://github.com/agentxm/axm-b/issues"
dev-repo: "git+https://github.com/agentxm/axm-b.git"
flags: ["light-uninstall"]

depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "agentxm-example-tinyflags" {= "0.1.0"}
  "alcotest" {with-test & >= "1.7.0"}
]

build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
