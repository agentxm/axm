{
  "name": "@agentxm/agent-integration",
  "version": "0.29.2",
  "description": "AXM agent integration: effectful detection of installed AI coding agents plus the native-format mechanics AXM writes into them — coding-agent adapters, subagent rendering, MCP entry projection and config writing, hook-group editing, and the ownership marker grammar. Unstable and unsupported — use the axm.sh CLI.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "homepage": "https://axm.sh",
  "bugs": {
    "url": "https://github.com/agentxm/axm/issues"
  },
  "author": "AgentXM <hello@agentxm.ai> (https://agentxm.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm.git",
    "directory": "packages/supporting/agent-integration"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "axm-source": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./live": {
      "types": "./dist/src/live.d.ts",
      "axm-source": "./src/live.ts",
      "default": "./dist/src/live.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "axm-source": "./src/testing.ts",
      "default": "./dist/src/testing.js"
    }
  },
  "files": [
    "dist/src/",
    "!**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {
    "@agentxm/extension-model": "workspace:^",
    "effect": "catalog:",
    "jsonc-parser": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@typescript/native": "catalog:",
    "@fast-check/vitest": "catalog:",
    "smol-toml": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
