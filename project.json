{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "axm",
  "root": ".",
  "tags": ["type:tooling", "scope:root"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "allurerc.ts",
          "eslint.config.mjs",
          "vitest.config.ts",
          "vitest.reporting.ts",
          "scripts"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["utils:build", "core:build"],
      "inputs": ["{workspaceRoot}/package.json", "{workspaceRoot}/scripts/**/*", "sharedGlobals"],
      "options": {
        "command": "tsc -p scripts/tsconfig.json --noEmit",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["utils:build", "core:build"],
      "inputs": ["{workspaceRoot}/package.json", "{workspaceRoot}/scripts/**/*", "sharedGlobals"],
      "outputs": ["{workspaceRoot}/test-results/scripts"],
      "options": {
        "command": "pnpm exec vitest run --config scripts/vitest.config.ts",
        "cwd": "."
      }
    },
    "test-report": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": "*",
          "target": "test"
        }
      ],
      "outputs": ["{workspaceRoot}/test-results/allure-report"],
      "options": {
        "command": "pnpm exec allure generate \"test-results/**/allure-results\"",
        "cwd": "."
      }
    },
    "allure-report": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/test-results/allure-report"],
      "options": {
        "command": "pnpm exec allure generate \"test-results/**/allure-results\"",
        "cwd": "."
      }
    },
    "allure-report-open": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["allure-report"],
      "options": {
        "command": "pnpm exec allure open test-results/allure-report",
        "cwd": "."
      }
    },
    "release-prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build", "core:build"],
      "options": {
        "command": "bun scripts/release-prepare.ts",
        "cwd": "."
      }
    },
    "release-publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build", "core:build"],
      "options": {
        "command": "bun scripts/release-publish.ts",
        "cwd": "."
      }
    },
    "release-publish-local": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build", "core:build"],
      "options": {
        "command": "bun scripts/release-publish-local.ts",
        "cwd": "."
      }
    },
    "validate-release-tag": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build", "core:build"],
      "options": {
        "command": "bun scripts/validate-release-tag.ts",
        "cwd": "."
      }
    },
    "resolve-release-meta": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build", "core:build"],
      "options": {
        "command": "bun scripts/resolve-release-meta.ts",
        "cwd": "."
      }
    },
    "download-ci-binaries": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build", "core:build"],
      "options": {
        "command": "bun scripts/download-ci-binaries.ts",
        "cwd": "."
      }
    },
    "generate-release-checksums": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun scripts/release-checksums.ts generate",
        "cwd": "."
      }
    },
    "validate-release-assets": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash scripts/validate-release-assets.sh",
        "cwd": "."
      }
    },
    "update-homebrew-formula": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash scripts/update-homebrew-formula.sh",
        "cwd": "."
      }
    },
    "parity-ledger-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun scripts/parity-ledger-check.ts",
        "cwd": "."
      }
    },
    "verify-source-hygiene": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/scripts/**/*",
        "sharedGlobals",
        "{workspaceRoot}/packages/*/src/**/*"
      ],
      "options": {
        "command": "bun scripts/verify-source-hygiene.ts",
        "cwd": "."
      }
    },
    "specification-verdict": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun scripts/specification-verdict.ts",
        "cwd": "."
      }
    }
  }
}
