{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "specifications",
  "projectType": "library",
  "root": "specifications",
  "sourceRoot": "specifications",
  "tags": ["type:specification", "role:tooling", "scope:specifications"],
  "targets": {
    "test": {
      "dependsOn": ["^build"]
    },
    "test-memory": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/vitest.reporting.ts",
        "{workspaceRoot}/scripts/specification-evidence-reporter.ts",
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        }
      ],
      "outputs": ["{workspaceRoot}/test-results/specifications-memory"],
      "options": {
        "command": "vitest run --config vitest.memory.config.ts",
        "cwd": "specifications"
      }
    }
  }
}
