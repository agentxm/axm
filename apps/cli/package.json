{
  "name": "axm.sh",
  "version": "0.35.0",
  "description": "Extension manager for AI coding agents — install skills, subagents, MCP servers, rules, hooks, knowledge, and packs across Claude Code, Codex, Cursor, Copilot, and more.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "homepage": "https://axm.sh",
  "bugs": {
    "url": "https://github.com/agentxm/axm/issues"
  },
  "author": "AgentXM <hello@agentxm.ai> (https://agentxm.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "agent",
    "agents",
    "ai-agent",
    "agent-extensions",
    "agent-skills",
    "extensions",
    "extension-manager",
    "cli",
    "anthropic",
    "mcp",
    "mcp-server",
    "skill",
    "skills",
    "subagent",
    "subagents",
    "pack",
    "claude-code",
    "github-copilot-cli",
    "cursor",
    "gemini-cli",
    "codex",
    "opencode",
    "windsurf",
    "cline",
    "goose",
    "qwen-code"
  ],
  "exports": {
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "axm-source": "./src/runtime.ts",
      "experimental": "./dist/src/runtime.js",
      "default": "./dist/src/runtime.js"
    }
  },
  "files": [
    "dist/src/",
    "!**/*.map",
    "site-content/"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "axm": "./dist/src/main.js"
    }
  },
  "nx": {
    "includedScripts": []
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@agentxm/cli-maintenance": "workspace:^",
    "@agentxm/extension-model": "workspace:^",
    "@agentxm/registry-access": "workspace:^",
    "@agentxm/registry-client": "workspace:^",
    "@agentxm/registry-protocol": "workspace:^",
    "@agentxm/workspace": "workspace:^",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@agentxm/extension-content": "workspace:^",
    "@agentxm/extension-type-parity": "workspace:*",
    "@agentxm/test-support": "workspace:^",
    "@effect/openapi-generator": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/semver": "catalog:",
    "@typescript/native": "catalog:",
    "@xterm/headless": "6.0.0",
    "fflate": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
