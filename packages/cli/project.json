{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli",
  "projectType": "application",
  "root": "packages/cli",
  "sourceRoot": "packages/cli/src",
  "tags": ["type:app", "scope:cli"],
  "targets": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "executor": "@nx/js:tsc",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "main": "packages/cli/src/main.ts",
        "outputPath": "packages/cli/dist",
        "tsConfig": "packages/cli/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false
      }
    },
    "watch": {
      "cache": false,
      "dependsOn": ["^build"],
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/cli/src/main.ts",
        "outputPath": "packages/cli/dist",
        "tsConfig": "packages/cli/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false,
        "watch": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{ts,tsx,js,mjs,cjs}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "packages/cli"
      }
    },
    "generate-schemas": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/generate-schemas.ts"],
        "cwd": "packages/cli"
      }
    },
    "compile": {
      "cache": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/bin"],
      "options": {
        "command": ["bun", "scripts/compile.ts"],
        "cwd": "packages/cli"
      }
    },
    "compile-host": {
      "cache": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/bin"],
      "options": {
        "command": ["bun", "scripts/compile.ts", "--host-only"],
        "cwd": "packages/cli"
      }
    },
    "release-verify": {
      "cache": false,
      "dependsOn": ["cli-e2e:e2e", "cli-spike-e2e:e2e"],
      "executor": "nx:noop"
    },
    "nx-release-publish": {
      "cache": false,
      "dependsOn": ["build", "^nx-release-publish"],
      "executor": "@nx/js:release-publish"
    }
  }
}
