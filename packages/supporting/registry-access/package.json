{
  "name": "@agentxm/registry-access",
  "version": "0.30.2",
  "description": "AXM Registry access capability: authentication, credential lifecycle, identity inspection, token authority, and environment adapters for the axm CLI. Unstable and unsupported \u2014 use the axm.sh CLI.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "homepage": "https://axm.sh",
  "bugs": {
    "url": "https://github.com/agentxm/axm/issues"
  },
  "author": "AgentXM <hello@agentxm.ai> (https://agentxm.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm.git",
    "directory": "packages/supporting/registry-access"
  },
  "sideEffects": false,
  "exports": {
    "./authentication": {
      "types": "./dist/src/authentication/index.d.ts",
      "axm-source": "./src/authentication/index.ts",
      "default": "./dist/src/authentication/index.js"
    },
    "./credentials": {
      "types": "./dist/src/credentials/index.d.ts",
      "axm-source": "./src/credentials/index.ts",
      "default": "./dist/src/credentials/index.js"
    },
    "./adapters": {
      "types": "./dist/src/adapters/index.d.ts",
      "axm-source": "./src/adapters/index.ts",
      "default": "./dist/src/adapters/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "axm-source": "./src/testing.ts",
      "default": "./dist/src/testing.js"
    }
  },
  "files": [
    "dist/src/",
    "!**/*.map"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {
    "@agentxm/extension-model": "workspace:^",
    "@agentxm/registry-client": "workspace:^",
    "@agentxm/registry-protocol": "workspace:^",
    "@napi-rs/keyring": "^1.3.0",
    "effect": "catalog:",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@agentxm/specification-metadata": "workspace:^",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true
}
