{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "extension-management",
  "projectType": "library",
  "root": "packages/extension-management",
  "sourceRoot": "packages/extension-management/src",
  "tags": ["type:lib", "layer:feature", "scope:core", "release:cli"],
  "targets": {
    "generate": {
      "executor": "nx:noop",
      "dependsOn": [
        "generate:registry-client",
        "generate:telemetry-client",
        "generate:e2e-extension-matrix"
      ]
    },
    "generate:e2e-extension-matrix": {
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/generate-e2e-extension-matrix.ts",
        "{workspaceRoot}/packages/extension-model/src/unstable/extensions/common.ts",
        "{projectRoot}/src/unstable/extension-types/parity/**/*.ts",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": ["{workspaceRoot}/packages/cli-e2e/src/__generated__/extension-type-matrix.ts"],
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/generate-e2e-extension-matrix.ts"],
        "cwd": "packages/extension-management"
      },
      "dependsOn": ["^build"]
    },
    "generate:registry-client": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/generate-registry-client.ts",
        "{projectRoot}/specs/registry-openapi.json",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": ["{projectRoot}/src/unstable/registry/__generated__/registry-client.ts"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/generate-registry-client.ts"
      }
    },
    "generate:telemetry-client": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/generate-telemetry-client.ts",
        "{projectRoot}/specs/telemetry-openapi.json",
        "{workspaceRoot}/.prettierrc.json"
      ],
      "outputs": ["{projectRoot}/src/unstable/telemetry/__generated__/telemetry-client.ts"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/generate-telemetry-client.ts"
      }
    },
    "sync:registry-spec": {
      "cache": false,
      "inputs": ["{workspaceRoot}/scripts/sync-registry-spec.ts"],
      "outputs": ["{projectRoot}/specs/registry-openapi.json"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/sync-registry-spec.ts"
      }
    },
    "sync:telemetry-spec": {
      "cache": false,
      "inputs": ["{workspaceRoot}/scripts/sync-telemetry-spec.ts"],
      "outputs": ["{projectRoot}/specs/telemetry-openapi.json"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/sync-telemetry-spec.ts"
      }
    },
    "build": {
      "dependsOn": ["...", "generate"],
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/extension-management/src/unstable/app-error/index.ts",
        "outputPath": "packages/extension-management/dist",
        "tsConfig": "packages/extension-management/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false
      }
    },
    "lint": {
      "dependsOn": ["generate"]
    },
    "test-windows": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/extension-management-windows"],
      "options": {
        "command": "pnpm exec vitest run --config vitest.windows.config.ts",
        "cwd": "packages/extension-management"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish"
    }
  }
}
