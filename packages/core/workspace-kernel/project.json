{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace-kernel",
  "projectType": "library",
  "root": "packages/core/workspace-kernel",
  "sourceRoot": "packages/core/workspace-kernel/src",
  "tags": ["type:lib", "role:capability", "scope:workspace-kernel"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/core/workspace-kernel/src/settlement/index.ts",
        "outputPath": "packages/core/workspace-kernel/dist",
        "tsConfig": "packages/core/workspace-kernel/tsconfig.lib.json",
        "clean": true,
        "generatePackageJson": false
      }
    },
    "test": {
      "dependsOn": ["build", "specification-metadata:build"]
    },
    "test-windows": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production", "toolchain"],
      "outputs": ["{workspaceRoot}/test-results/workspace-windows"],
      "options": {
        "command": "pnpm exec vitest run --config vitest.windows.config.ts",
        "cwd": "packages/core/workspace-kernel"
      }
    }
  }
}
