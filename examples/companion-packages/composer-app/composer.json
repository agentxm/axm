{
    "name": "agentxm/example-pawmatch",
    "description": "PawMatch — Composer PHP consumer of the TinyFlags example library.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "agentxm/example-tinyflags": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../composer-lib"
        }
    ],
    "autoload": {
        "psr-4": {
            "AgentXM\\Examples\\PawMatch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgentXM\\Examples\\PawMatch\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/pawmatch"
    ],
    "scripts": {
        "start": "@php bin/pawmatch",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
