{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentXM Telemetry Ingest API",
    "version": "0.1.0",
    "description": "Telemetry ingest API for product-analytics events and error reports."
  },
  "paths": {
    "/v1": {
      "get": {
        "tags": ["Meta"],
        "operationId": "Meta.get",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Service metadata and documentation entrypoints exposed by the telemetry root endpoint. Documentation URLs are null when docs are disabled for the environment.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TelemetryMetaResponse" }
              }
            }
          },
          "400": {
            "description": "DecodeErrorResponse | BadRequest",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/DecodeErrorResponse" }
              }
            }
          }
        },
        "description": "Returns service metadata and the documentation entrypoints.",
        "summary": "Get telemetry service metadata"
      }
    },
    "/v1/health": {
      "get": {
        "tags": ["Health"],
        "operationId": "Health.getShallowHealth",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["pass", "warn", "fail"] }
                  },
                  "required": ["status"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "DecodeErrorResponse | BadRequest",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/DecodeErrorResponse" }
              }
            }
          }
        },
        "description": "Returns pass/fail status. Public, no auth required.",
        "summary": "Shallow health check"
      }
    },
    "/v1/health/dependencies": {
      "get": {
        "tags": ["Health"],
        "operationId": "Health.getDeepHealth",
        "parameters": [
          {
            "name": "x-health-key",
            "in": "header",
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
                    "serviceId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                    "version": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                    "releaseId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                    "commit": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                    "deployedAt": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                    "environment": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                    "region": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                    "checks": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "componentName": { "type": "string" },
                                "componentType": {
                                  "type": "string",
                                  "enum": ["datastore", "system", "component"]
                                },
                                "measurementName": { "type": "string" },
                                "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
                                "observedValue": { "type": "number" },
                                "observedUnit": { "type": "string" },
                                "time": { "type": "string" }
                              },
                              "required": [
                                "componentName",
                                "componentType",
                                "measurementName",
                                "status",
                                "observedValue",
                                "observedUnit",
                                "time"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        { "type": "null" }
                      ]
                    },
                    "output": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
                  },
                  "required": ["status"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "DecodeErrorResponse | BadRequest",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/DecodeErrorResponse" }
              }
            }
          }
        },
        "description": "Returns IETF health+json response with per-dependency check results. Requires X-Health-Key header.",
        "summary": "Deep health check with dependency status"
      }
    },
    "/v1/debug/observability": {
      "get": {
        "tags": ["Health"],
        "operationId": "Health.getObservabilityVerification",
        "parameters": [
          {
            "name": "x-health-key",
            "in": "header",
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "required": false
          },
          {
            "name": "level",
            "in": "query",
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "required": false
          },
          {
            "name": "scenario",
            "in": "query",
            "schema": {
              "anyOf": [
                { "type": "string", "enum": ["effect-handled-500", "surface-unhandled-500"] },
                { "type": "null" }
              ]
            },
            "required": false
          },
          {
            "name": "scenarioId",
            "in": "query",
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["ok", "error"] },
                    "timestamp": { "type": "string" },
                    "serviceId": { "type": "string" },
                    "level": { "type": "string", "enum": ["basic", "standard", "full"] },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "logging": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "status": { "type": "string", "enum": ["ok", "error"] },
                                "correlationId": { "type": "string" }
                              },
                              "required": ["status", "correlationId"],
                              "additionalProperties": false
                            },
                            { "type": "null" }
                          ]
                        },
                        "tracing": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "status": { "type": "string", "enum": ["ok", "error"] },
                                "traceId": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
                              },
                              "required": ["status"],
                              "additionalProperties": false
                            },
                            { "type": "null" }
                          ]
                        },
                        "metrics": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "status": { "type": "string", "enum": ["ok", "error"] },
                                "counter": { "type": "string" }
                              },
                              "required": ["status", "counter"],
                              "additionalProperties": false
                            },
                            { "type": "null" }
                          ]
                        },
                        "errors": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "status": { "type": "string", "enum": ["ok", "error"] },
                                "sentryEventId": {
                                  "anyOf": [{ "type": "string" }, { "type": "null" }]
                                },
                                "reason": {
                                  "anyOf": [
                                    {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "enum": ["sentry-issue-reporter-disabled"]
                                        }
                                      ]
                                    },
                                    { "type": "null" }
                                  ]
                                },
                                "message": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
                              },
                              "required": ["status"],
                              "additionalProperties": false
                            },
                            { "type": "null" }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": ["status", "timestamp", "serviceId", "level", "checks"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "DecodeErrorResponse | BadRequest",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/DecodeErrorResponse" }
              }
            }
          }
        },
        "description": "Exercises observability pipelines and can simulate server error scenarios. Requires X-Health-Key header.",
        "summary": "Observability verification"
      }
    },
    "/v1/events": {
      "post": {
        "tags": ["Events"],
        "operationId": "Events.ingest",
        "parameters": [],
        "security": [],
        "responses": {
          "202": { "description": "<No Content>" },
          "400": {
            "description": "DecodeErrorResponse | BadRequest",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/DecodeErrorResponse" }
              }
            }
          },
          "413": {
            "description": "PayloadTooLargeError",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/PayloadTooLargeError" }
              }
            }
          }
        },
        "description": "Accepts a JSON batch of telemetry events. Content-Type must be application/json. Payloads exceeding 64 KB are rejected with 413.",
        "summary": "Ingest batched telemetry events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TelemetryEventsRequest" }
            }
          },
          "required": true
        }
      }
    },
    "/v1/errors": {
      "post": {
        "tags": ["Errors"],
        "operationId": "Errors.ingest",
        "parameters": [],
        "security": [],
        "responses": {
          "202": { "description": "<No Content>" },
          "400": {
            "description": "DecodeErrorResponse | BadRequest",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/DecodeErrorResponse" }
              }
            }
          }
        },
        "description": "Accepts telemetry error reports as JSON.\n\n**PII and secret filtering.** The server stores and forwards error reports\nas-is; it does not scrub, redact, or transform payload contents. Clients\nare responsible for stripping secrets, credentials, tokens, and personally\nidentifiable information before submission. In particular:\n\n- Remove environment variables, auth tokens, and API keys from stack traces,\n  breadcrumb data, and tags before sending.\n- The `user` field should contain only opaque identifiers (user ID or handle),\n  never email addresses, real names, or other PII.\n- Breadcrumb `data` maps must not include request/response bodies that may\n  carry user-generated content or credentials.\n- The `context` fields (os, runtime, device, ide) are considered low-risk\n  metadata but should still be reviewed for unexpected PII.",
        "summary": "Ingest error reports",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TelemetryErrorsRequest" }
            }
          },
          "required": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TelemetryMetaResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "enum": [true] },
          "service": { "type": "string", "enum": ["telemetry"] },
          "message": { "type": "string" },
          "docs": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "openapi": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "required": ["ok", "service", "message", "docs", "openapi"],
        "additionalProperties": false,
        "title": "Telemetry Meta Response",
        "description": "Service metadata and documentation entrypoints exposed by the telemetry root endpoint. Documentation URLs are null when docs are disabled for the environment."
      },
      "DecodeErrorResponse": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["DecodeErrorResponse"] },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": { "type": "string" }
        },
        "required": ["kind", "type", "title", "status", "detail", "code"],
        "additionalProperties": false
      },
      "TelemetryEvent": {
        "type": "object",
        "properties": {
          "event": { "type": "string", "allOf": [{ "minLength": 1 }] },
          "distinctId": { "type": "string", "allOf": [{ "minLength": 1 }] },
          "timestamp": { "type": "string", "allOf": [{ "minLength": 1, "format": "date-time" }] },
          "properties": { "type": "object" },
          "userProperties": {
            "type": "object",
            "properties": { "set": { "type": "object" }, "setOnce": { "type": "object" } },
            "additionalProperties": false
          },
          "groups": { "type": "object", "additionalProperties": { "type": "string" } },
          "sessionId": { "type": "string" },
          "anonymous": { "type": "boolean" }
        },
        "required": ["event", "distinctId", "timestamp"],
        "additionalProperties": false,
        "title": "Telemetry Event",
        "description": "One analytics event captured by the AgentXM client or integration."
      },
      "TelemetryClientContext": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "allOf": [{ "minLength": 1 }] },
          "version": { "type": "string", "allOf": [{ "minLength": 1 }] }
        },
        "required": ["name", "version"],
        "additionalProperties": false,
        "title": "Telemetry Client Context",
        "description": "Identifies the client emitting telemetry, including its name and version."
      },
      "TelemetryContext": {
        "type": "object",
        "properties": {
          "client": { "$ref": "#/components/schemas/TelemetryClientContext" },
          "os": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "allOf": [{ "minLength": 1 }] },
              "version": { "type": "string" }
            },
            "required": ["name"],
            "additionalProperties": false,
            "title": "Operating System Context",
            "description": "Operating system metadata captured alongside telemetry."
          },
          "runtime": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "allOf": [{ "minLength": 1 }] },
              "version": { "type": "string", "allOf": [{ "minLength": 1 }] }
            },
            "required": ["name", "version"],
            "additionalProperties": false,
            "title": "Runtime Context",
            "description": "Language or process runtime metadata captured alongside telemetry."
          },
          "device": {
            "type": "object",
            "properties": { "arch": { "type": "string", "allOf": [{ "minLength": 1 }] } },
            "required": ["arch"],
            "additionalProperties": false,
            "title": "Device Context",
            "description": "Device characteristics attached to telemetry submissions."
          },
          "ide": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "allOf": [{ "minLength": 1 }] },
              "version": { "type": "string", "allOf": [{ "minLength": 1 }] }
            },
            "required": ["name", "version"],
            "additionalProperties": false,
            "title": "IDE Context",
            "description": "Editor or IDE metadata attached when telemetry originates from a development tool."
          },
          "environment": { "type": "string" },
          "ci": { "type": "boolean" }
        },
        "required": ["client"],
        "additionalProperties": false,
        "title": "Telemetry Context",
        "description": "Shared environment metadata attached to analytics event batches."
      },
      "TelemetryEventsRequest": {
        "type": "object",
        "properties": {
          "events": { "type": "array", "items": { "$ref": "#/components/schemas/TelemetryEvent" } },
          "sentAt": { "type": "string", "format": "date-time" },
          "context": { "$ref": "#/components/schemas/TelemetryContext" }
        },
        "required": ["events", "context"],
        "additionalProperties": false,
        "title": "Telemetry Events Request",
        "description": "Request payload accepted by the telemetry events ingestion endpoint."
      },
      "PayloadTooLargeError": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["PayloadTooLargeError"] },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": { "type": "string" }
        },
        "required": ["kind", "type", "title", "status", "detail", "code"],
        "additionalProperties": false
      },
      "TelemetryStackFrame": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "function": { "type": "string" },
          "lineno": { "type": "integer" },
          "colno": { "type": "integer" },
          "absPath": { "type": "string" },
          "inApp": { "type": "boolean" },
          "contextLine": { "type": "string" },
          "preContext": { "type": "array", "items": { "type": "string" } },
          "postContext": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "TelemetryErrorItem": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "allOf": [{ "minLength": 1 }] },
          "name": { "type": "string", "allOf": [{ "minLength": 1 }] },
          "module": { "type": "string" },
          "stackFrames": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TelemetryStackFrame" },
            "allOf": [{ "maxItems": 100 }]
          },
          "stack": { "type": "string" }
        },
        "required": ["message", "name"],
        "additionalProperties": false,
        "title": "Telemetry Error Item",
        "description": "One error instance included in a telemetry error report."
      },
      "TelemetryBreadcrumb": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "category": { "type": "string" },
          "message": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "level": {
            "type": "string",
            "enum": ["fatal", "error", "warning", "info", "debug"],
            "title": "Severity Level",
            "description": "Severity level associated with an error report or breadcrumb."
          },
          "data": { "type": "object" }
        },
        "additionalProperties": false,
        "title": "Telemetry Breadcrumb",
        "description": "Lightweight diagnostic breadcrumb attached to an error report."
      },
      "TelemetryErrorContext": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "allOf": [{ "minLength": 1 }] },
          "client": { "$ref": "#/components/schemas/TelemetryClientContext" },
          "os": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "allOf": [{ "minLength": 1 }] },
              "version": { "type": "string" }
            },
            "required": ["name"],
            "additionalProperties": false,
            "title": "Operating System Context",
            "description": "Operating system metadata captured alongside telemetry."
          },
          "runtime": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "allOf": [{ "minLength": 1 }] },
              "version": { "type": "string", "allOf": [{ "minLength": 1 }] }
            },
            "required": ["name", "version"],
            "additionalProperties": false,
            "title": "Runtime Context",
            "description": "Language or process runtime metadata captured alongside telemetry."
          },
          "device": {
            "type": "object",
            "properties": { "arch": { "type": "string", "allOf": [{ "minLength": 1 }] } },
            "required": ["arch"],
            "additionalProperties": false,
            "title": "Device Context",
            "description": "Device characteristics attached to telemetry submissions."
          },
          "ide": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "allOf": [{ "minLength": 1 }] },
              "version": { "type": "string", "allOf": [{ "minLength": 1 }] }
            },
            "required": ["name", "version"],
            "additionalProperties": false,
            "title": "IDE Context",
            "description": "Editor or IDE metadata attached when telemetry originates from a development tool."
          },
          "environment": { "type": "string" },
          "ci": { "type": "boolean" }
        },
        "required": ["command", "client"],
        "additionalProperties": false,
        "title": "Telemetry Error Context",
        "description": "Execution context attached to error-report submissions."
      },
      "TelemetryErrorsRequest": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TelemetryErrorItem" },
            "allOf": [{ "minItems": 1 }, { "maxItems": 10 }]
          },
          "level": {
            "type": "string",
            "enum": ["fatal", "error", "warning", "info", "debug"],
            "title": "Severity Level",
            "description": "Severity level associated with an error report or breadcrumb."
          },
          "handled": { "type": "boolean" },
          "breadcrumbs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TelemetryBreadcrumb" },
            "allOf": [{ "maxItems": 50 }]
          },
          "tags": {
            "type": "object",
            "additionalProperties": { "type": "string", "allOf": [{ "maxLength": 200 }] }
          },
          "fingerprint": {
            "type": "array",
            "items": { "type": "string" },
            "allOf": [{ "maxItems": 10 }]
          },
          "user": {
            "type": "object",
            "properties": { "id": { "type": "string" }, "username": { "type": "string" } },
            "additionalProperties": false
          },
          "sentAt": { "type": "string", "format": "date-time" },
          "context": { "$ref": "#/components/schemas/TelemetryErrorContext" }
        },
        "required": ["errors", "context"],
        "additionalProperties": false,
        "title": "Telemetry Errors Request",
        "description": "Request payload accepted by the telemetry error ingestion endpoint."
      }
    },
    "securitySchemes": {}
  },
  "security": [],
  "tags": [{ "name": "Meta" }, { "name": "Health" }, { "name": "Events" }, { "name": "Errors" }],
  "servers": [
    { "url": "http://localhost:4301", "description": "Local dev" },
    { "url": "https://t.agentxm.ai", "description": "Production domain target" }
  ]
}
