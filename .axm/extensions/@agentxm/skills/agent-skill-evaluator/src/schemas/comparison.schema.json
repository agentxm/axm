{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentxm.dev/schemas/agent-skill-evaluator/comparison-1.0.0.json",
  "title": "Agent Skill evaluation comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline_mode", "ordering", "configurations"],
  "properties": {
    "baseline_mode": { "enum": ["none", "without-skill", "package"] },
    "ordering": { "enum": ["single-configuration", "alternating-by-trial"] },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "active_skill", "target"],
        "properties": {
          "id": { "type": "string" },
          "role": { "enum": ["candidate", "baseline"] },
          "active_skill": { "type": "boolean" },
          "target": { "type": ["object", "null"] }
        }
      }
    }
  }
}
