{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "parallel": 2,
  "maxCacheSize": "2GB",
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": false,
        "build": false
      }
    },
    "./scripts/typecheck-plugin.ts",
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "include": ["packages/**/vitest.config.ts", "specifications/vitest.config.ts"],
      "exclude": ["packages/cli-e2e/**"],
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    },
    {
      "plugin": "@nx/vitest",
      "include": ["packages/cli-e2e/vitest.config.ts"],
      "options": {
        "testTargetName": "e2e-main",
        "testMode": "run"
      }
    }
  ],
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "namedInputs": {
    "sharedGlobals": ["{workspaceRoot}/tsconfig*.json", "{workspaceRoot}/vitest.reporting.ts"],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/scripts/**",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.e2e.test.ts",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.type-test.ts",
      "!{projectRoot}/vitest*.config.ts",
      "!{projectRoot}/**/*.bench.ts"
    ]
  },
  "targetDefaults": {
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "@nx/eslint:lint": {
      "cache": true,
      "options": {
        "maxWarnings": 192
      },
      "inputs": ["default", "^default", "^production", "{workspaceRoot}/eslint.config.mjs"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/test-results/{projectName}"]
    },
    "nx-release-publish": {
      "cache": false,
      "dependsOn": ["build", "^nx-release-publish"]
    }
  },
  "release": {
    "projects": ["tag:release:cli"],
    "projectsRelationship": "fixed",
    "versionPlans": true,
    "releaseTag": {
      "pattern": "cli-v{version}",
      "requireSemver": true
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": false,
      "automaticFromRef": true
    },
    "version": {
      "currentVersionResolver": "disk",
      "preVersionCommand": "pnpm run ci"
    }
  },
  "analytics": false
}
