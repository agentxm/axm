{
  "name": "@agentxm/cli-update",
  "version": "0.30.0",
  "description": "AXM self-update capability: install-ownership detection, release-channel and exact-version resolution, the startup update check, and the verified upgrade of the installed axm executable. Unstable and unsupported — use the axm.sh CLI.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "homepage": "https://axm.sh",
  "bugs": {
    "url": "https://github.com/agentxm/axm/issues"
  },
  "author": "AgentXM <hello@agentxm.ai> (https://agentxm.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm.git",
    "directory": "packages/core/cli-update"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "axm-source": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./live": {
      "types": "./dist/src/live.d.ts",
      "axm-source": "./src/live.ts",
      "default": "./dist/src/live.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "axm-source": "./src/testing.ts",
      "default": "./dist/src/testing.js"
    }
  },
  "files": [
    "dist/src/",
    "!**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {
    "@agentxm/extension-model": "workspace:^",
    "@agentxm/registry-client": "workspace:^",
    "@agentxm/workspace-operations": "workspace:^",
    "effect": "catalog:",
    "semver": "catalog:",
    "@agentxm/cli-maintenance": "workspace:^"
  },
  "devDependencies": {
    "@agentxm/specification-metadata": "workspace:^",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/semver": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
