{
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "preferSchemaOverJson": "off",
          "unnecessaryFailYieldableError": "warning",
          "multipleEffectProvide": "warning",
          "deterministicKeys": "error",
          "returnEffectInGen": "error",
          "tryCatchInEffectGen": "warning",
          "leakingRequirements": "warning",
          "globalConsole": "warning",
          "globalConsoleInEffect": "warning",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "nodeBuiltinImport": "warning",
          "effectFnOpportunity": "suggestion",
          "schemaStructWithTag": "suggestion"
        }
      }
    ],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
