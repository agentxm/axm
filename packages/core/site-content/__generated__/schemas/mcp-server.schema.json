{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/McpServerManifest",
  "definitions": {
    "Handle": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^@[a-z0-9_](?:[a-z0-9_-]*[a-z0-9_])?$",
          "title": "Handle",
          "description": "A unique username or organization name starting with @, like @my-org.",
          "examples": ["@my-org", "@username"]
        }
      ]
    },
    "Version": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "title": "Version",
          "description": "A semver version like 1.0.0. Ranges are not allowed here.",
          "examples": ["1.0.0", "2.3.1", "0.1.0-beta.1"]
        }
      ]
    },
    "Author": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "url": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["name"],
      "additionalProperties": false,
      "title": "Author",
      "description": "A person credited as a creator or maintainer of this extension."
    },
    "PackageUrl": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[Pp][Kk][Gg]:[a-zA-Z][a-zA-Z0-9.+-]*\\/.+$",
          "title": "Package URL",
          "description": "A Package URL (purl) string identifying a package across ecosystems (e.g. pkg:npm/react@18.2.0).",
          "examples": ["pkg:npm/react@18.2.0", "pkg:pypi/requests@2.31.0", "pkg:cargo/serde@1.0"]
        }
      ]
    },
    "PackSpec": {
      "type": "string",
      "allOf": [
        { "minLength": 1 },
        {
          "pattern": "^(@[a-z0-9_](?:[a-z0-9_-]*[a-z0-9_])?)\\/packs\\/([a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)(?:@.+)?$",
          "title": "Pack Spec",
          "description": "Pack reference with an optional version constraint suffix. Used in places like an extension's recommendedPacks list, where a pack can be pinned to a version range.",
          "examples": ["@acme/packs/typescript", "@acme/packs/typescript@^1.0.0"]
        }
      ]
    },
    "ExtensionName": {
      "type": "string",
      "allOf": [
        { "minLength": 1 },
        {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Extension Name",
          "description": "Short name for this MCP server within its owner namespace. Combined with owner, forms the FQN @owner/mcp-servers/<name>.",
          "examples": ["my-skill", "code-review", "prettier"]
        }
      ]
    },
    "McpServerManifest": {
      "type": "object",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string",
              "description": "JSON Schema URL used by editors for validation and completions. Typically set automatically by axm."
            },
            { "type": "null" }
          ]
        },
        "owner": { "$ref": "#/definitions/Handle" },
        "version": { "$ref": "#/definitions/Version" },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "description": "Short, registry-facing summary of this extension shown in listings and search results."
            },
            { "type": "null" }
          ]
        },
        "keywords": {
          "anyOf": [
            {
              "type": "array",
              "description": "Search terms surfaced by registry listings and 'axm search' to help users discover this extension.",
              "examples": [["lint", "typescript", "review"]],
              "items": { "type": "string", "allOf": [{ "minLength": 1 }] }
            },
            { "type": "null" }
          ]
        },
        "repository": {
          "anyOf": [
            {
              "type": "string",
              "description": "Source repository URL where this extension is developed.",
              "examples": ["https://github.com/acme/code-review"],
              "format": "uri"
            },
            { "type": "null" }
          ]
        },
        "homepage": {
          "anyOf": [
            {
              "type": "string",
              "description": "Project homepage or documentation site for this extension.",
              "examples": ["https://acme.dev/code-review"],
              "format": "uri"
            },
            { "type": "null" }
          ]
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1,
                  "description": "SPDX license expression covering this extension's content.",
                  "examples": ["MIT", "Apache-2.0"]
                }
              ]
            },
            { "type": "null" }
          ]
        },
        "bugs": {
          "anyOf": [
            {
              "type": "string",
              "description": "Issue tracker URL where users can report bugs for this extension.",
              "examples": ["https://github.com/acme/code-review/issues"],
              "format": "uri"
            },
            { "type": "null" }
          ]
        },
        "authors": {
          "anyOf": [
            {
              "type": "array",
              "description": "People who created or maintain this extension.",
              "items": { "$ref": "#/definitions/Author" }
            },
            { "type": "null" }
          ]
        },
        "compatiblePackages": {
          "anyOf": [
            {
              "type": "array",
              "description": "External ecosystem packages this extension targets (e.g. the npm or PyPI package an MCP server wraps), identified by Package URL (purl).",
              "items": { "$ref": "#/definitions/PackageUrl" }
            },
            { "type": "null" }
          ]
        },
        "recommendedPacks": {
          "anyOf": [
            {
              "type": "array",
              "description": "Packs this extension is designed to work alongside. Each entry is a pack spec, optionally pinned to a version range.",
              "items": { "$ref": "#/definitions/PackSpec" }
            },
            { "type": "null" }
          ]
        },
        "standalone": {
          "anyOf": [
            {
              "type": "boolean",
              "description": "Set to false to indicate this extension only makes sense when installed alongside one of its recommendedPacks.",
              "default": true
            },
            { "type": "null" }
          ]
        },
        "type": {
          "type": "string",
          "enum": ["mcp-server"],
          "description": "Discriminator for the manifest kind. Always 'mcp-server' for mcp-server.json."
        },
        "name": { "$ref": "#/definitions/ExtensionName" }
      },
      "required": ["owner", "version", "type", "name"],
      "additionalProperties": false,
      "title": "MCP Server Manifest",
      "description": "MCP server extension manifest (mcp-server.json). Registers a Model Context Protocol server that coding agents can connect to for additional tools and resources."
    }
  }
}
