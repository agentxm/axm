{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli-e2e",
  "projectType": "application",
  "root": "apps/cli-e2e",
  "sourceRoot": "apps/cli-e2e/src",
  "tags": ["type:e2e", "role:e2e", "scope:cli"],
  "targets": {
    "preview": {
      "metadata": {
        "description": "Run the source CLI under a pseudo-terminal and print the screen after a step script: --size <columns>x<rows>, --steps <script>, --frames, --workspace <dir>, --home <dir>, then -- <axm arguments>."
      },
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "bun src/pty-preview.ts",
        "cwd": "apps/cli-e2e",
        "forwardAllArgs": true
      }
    },
    "e2e-main": {
      "cache": false,
      "parallelism": false,
      "dependsOn": ["cli:compile-host"],
      "inputs": [
        "...",
        "^production",
        "hostPlatform",
        {
          "env": "AXM_E2E_CLI_SOURCE"
        }
      ],
      "outputs": ["{workspaceRoot}/test-results/cli-e2e"]
    },
    "e2e-windows": {
      "cache": false,
      "dependsOn": ["cli:build"],
      "inputs": [
        "default",
        "^production",
        "hostPlatform",
        {
          "env": "AXM_E2E_CLI_SOURCE"
        }
      ],
      "outputs": ["{workspaceRoot}/test-results/cli-e2e-windows"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.windows.config.ts",
        "cwd": "apps/cli-e2e"
      }
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["e2e-main", "binary-smoke", "install-suite"],
      "executor": "nx:noop"
    },
    "binary-smoke": {
      "cache": false,
      "parallelism": false,
      "dependsOn": ["cli:compile-host"],
      "inputs": ["default", "^production", "hostPlatform"],
      "outputs": ["{workspaceRoot}/test-results/cli-e2e-binary"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.binary.config.ts",
        "cwd": "apps/cli-e2e",
        "env": {
          "AXM_BINARY_SOURCE": "compiled"
        }
      }
    },
    "binary-smoke-artifact": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec vitest run --config vitest.binary.config.ts",
        "cwd": "apps/cli-e2e",
        "env": {
          "AXM_BINARY_SOURCE": "artifact"
        }
      }
    },
    "install-suite": {
      "cache": false,
      "parallelism": false,
      "dependsOn": ["cli:compile-host"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.install.config.ts",
        "cwd": "apps/cli-e2e"
      }
    },
    "install-verification": {
      "cache": false,
      "dependsOn": ["install-suite"],
      "executor": "nx:noop"
    }
  }
}
