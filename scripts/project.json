{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "scripts",
  "projectType": "library",
  "root": "scripts",
  "sourceRoot": "scripts",
  "tags": ["type:lib", "scope:scripts"],
  "implicitDependencies": ["utils"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["utils:build"],
      "inputs": ["default", "^production"],
      "options": {
        "command": "pnpm exec vitest run --config scripts/vitest.config.ts",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "scripts"
      }
    },
    "release-prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "bun scripts/release-prepare.ts",
        "cwd": "."
      }
    },
    "release-publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "bun scripts/release-publish.ts",
        "cwd": "."
      }
    },
    "validate-release-tag": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "bun scripts/validate-release-tag.ts",
        "cwd": "."
      }
    },
    "resolve-release-meta": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "bun scripts/resolve-release-meta.ts",
        "cwd": "."
      }
    },
    "download-ci-binaries": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["utils:build"],
      "options": {
        "command": "bun scripts/download-ci-binaries.ts",
        "cwd": "."
      }
    },
    "validate-release-assets": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash scripts/validate-release-assets.sh",
        "cwd": "."
      }
    },
    "update-homebrew-formula": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash scripts/update-homebrew-formula.sh",
        "cwd": "."
      }
    },
    "verify-e2e-boundaries": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "sharedGlobals",
        "{workspaceRoot}/packages/e2e-utils/package.json",
        "{workspaceRoot}/packages/e2e-utils/**/tsconfig*.json",
        "{workspaceRoot}/packages/cli-e2e/package.json",
        "{workspaceRoot}/packages/cli-e2e/**/tsconfig*.json",
        "{workspaceRoot}/packages/cli-spike-e2e/package.json",
        "{workspaceRoot}/packages/cli-spike-e2e/**/tsconfig*.json"
      ],
      "options": {
        "command": ["bun", "verify-e2e-boundaries.ts"],
        "cwd": "scripts"
      }
    }
  }
}
