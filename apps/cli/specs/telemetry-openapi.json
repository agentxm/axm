            "name": "x-health-key",
            "in": "header",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["pass", "warn", "fail"]
                    },
                    "serviceId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "version": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "releaseId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "commit": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "environment": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "region": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "checks": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "componentName": {
                                  "type": "string"
                                },
                                "componentType": {
                                  "type": "string",
                                  "enum": ["datastore", "system", "component"]
                                },
                                "measurementName": {
                                  "type": "string"
                                },
                                "status": {
                                  "type": "string",
                                  "enum": ["pass", "warn", "fail"]
                                },
                                "observedValue": {
                                  "type": "number"
                                },
                                "observedUnit": {
                                  "type": "string"
                                },
                                "time": {
                                  "$ref": "#/components/schemas/IsoDateTimeString"
                                },
                                "output": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "componentName",
                                "componentType",
                                "measurementName",
                                "status",
                                "observedValue",
                                "observedUnit",
                                "time"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "output": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["status"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "DecodeErrorResponse",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/DecodeErrorResponseEncoded"
                }
              }
            }
          }
        },
        "description": "Returns IETF health+json response with per-dependency check results. Requires X-Health-Key header.",
        "summary": "Deep health check with dependency status"
      }
    },
    "/v1/debug/observability": {
      "get": {
        "tags": ["Health"],
        "operationId": "Health.getObservabilityVerification",
        "parameters": [
          {
            "name": "x-health-key",
            "in": "header",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          },
          {
            "name": "level",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          },
          {
            "name": "scenario",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["effect-handled-500", "surface-unhandled-500"]
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          },
          {
            "name": "scenarioId",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok", "warn", "error"]
                    },
                    "timestamp": {
                      "$ref": "#/components/schemas/IsoDateTimeString"
                    },
                    "serviceId": {
                      "type": "string"
                    },
                    "level": {
                      "type": "string",
                      "enum": ["basic", "standard", "full"]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "logging": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "status": {
                                  "type": "string",
                                  "enum": ["ok", "warn", "error"]
                                },
                                "correlationId": {
                                  "type": "string"
                                }
                              },
                              "required": ["status", "correlationId"],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "tracing": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "status": {
                                  "type": "string",
                                  "enum": ["ok", "warn", "error"]
                                },
                                "traceId": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "message": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": ["status"],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "metrics": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "status": {
                                  "type": "string",
                                  "enum": ["ok", "warn", "error"]
                                },
                                "counter": {
                                  "type": "string"
                                }
                              },
                              "required": ["status", "counter"],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "errors": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "status": {
                                  "type": "string",
                                  "enum": ["ok", "warn", "error"]
                                },
                                "sentryEventId": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "reason": {
                                  "anyOf": [
                                    {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "enum": ["sentry-issue-reporter-disabled"]
                                        }
                                      ]
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "message": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": ["status"],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": ["status", "timestamp", "serviceId", "level", "checks"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "DecodeErrorResponse",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/DecodeErrorResponseEncoded"
                }
              }
            }
          }
        },
        "description": "Exercises observability pipelines and can simulate server error scenarios. Requires X-Health-Key header.",
        "summary": "Observability verification"
      }
    },
    "/v1/events": {
      "post": {
        "tags": ["Events"],
        "operationId": "Events.ingest",
        "parameters": [],
        "security": [],
        "responses": {
          "202": {
            "description": "<No Content>"
          },
          "400": {
            "description": "DecodeErrorResponse",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/DecodeErrorResponseEncoded"
                }
              }
            }
          },
          "413": {
            "description": "TelemetryPayloadTooLargeError",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryPayloadTooLargeErrorEncoded"
                }
              }
            }
          }
        },
        "description": "Accepts a JSON batch of telemetry events. Content-Type must be application/json. Payloads exceeding 64 KB are rejected with 413.",
        "summary": "Ingest batched telemetry events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryEventsRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v1/errors": {
      "post": {
        "tags": ["Errors"],
        "operationId": "Errors.ingest",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Synchronous receipt for a validated report. It is not durable acceptance, provider ingestion, or issue creation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryErrorReceipt"
                }
              }
            }
          },
          "400": {
            "description": "DecodeErrorResponse",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/DecodeErrorResponseEncoded"
                }
              }
            }
          }
        },
        "description": "Receives one bounded, allowlisted failure report from an opted-in client invocation.\n\n**Receipt.** A `200` response is a synchronous receipt: the report passed\nvalidation and its forwarding was registered as bounded, best-effort\nbackground work of the receiving invocation. The receipt is not durable\nacceptance, provider ingestion, or issue creation, and the service stores\nnothing. Forwarding may be dropped when a provider fails or the invocation's\nbackground deadline passes; no exactly-once delivery is promised.\n\n**Report identity.** Resubmitting the same report keeps its `eventId`. The\nservice carries that identity into the provider insert and event\nidentities, but provider deduplication is not an end-to-end guarantee.\n\n**Declared fields only.** Only the declared, bounded fields are accepted.\nUndeclared fields are ignored: the platform's request decoding drops them\nbefore the report is processed. Reports carry no messages, stack traces,\narguments, paths, or other free-form content.",
        "summary": "Receive a client error report",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryErrorReport"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TelemetryMetaResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [true]
          },
          "service": {
            "type": "string",
            "enum": ["telemetry"]
          },
          "message": {
            "type": "string"
          },
          "docs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "openapi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["ok", "service", "message", "docs", "openapi"],
        "additionalProperties": false,
        "title": "Telemetry Meta Response",
        "description": "Service metadata and documentation entrypoints exposed by the telemetry root endpoint. Documentation URLs are null when docs are disabled for the environment."
      },
      "DecodeErrorResponseEncoded": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["DecodeErrorResponse"]
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": ["kind", "type", "title", "status", "detail", "code"],
        "additionalProperties": false
      },
      "IsoDateTimeString": {
        "type": "string",
        "title": "ISO Date-Time String",
        "description": "A date and time string (e.g. 2024-01-15T12:00:00.000Z).",
        "format": "date-time"
      },
      "TelemetryEvent": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "description": "Producer-assigned event identity retained across delivery retries for downstream deduplication."
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "distinctId": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1,
                "format": "date-time"
              }
            ]
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              ],
              "title": "User Property Value",
              "description": "Telemetry user property value limited to JSON primitives or flat arrays of JSON primitives."
            }
          },
          "userProperties": {
            "type": "object",
            "properties": {
              "set": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  ],
                  "title": "User Property Value",
                  "description": "Telemetry user property value limited to JSON primitives or flat arrays of JSON primitives."
                }
              },
              "setOnce": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  ],
                  "title": "User Property Value",
                  "description": "Telemetry user property value limited to JSON primitives or flat arrays of JSON primitives."
                }
              }
            },
            "additionalProperties": false
          },
          "groups": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "sessionId": {
            "type": "string"
          },
          "anonymous": {
            "type": "boolean"
          }
        },
        "required": ["eventId", "event", "distinctId", "timestamp"],
        "additionalProperties": false,
        "title": "Telemetry Event",
        "description": "One analytics event captured by the AgentXM client or integration."
      },
      "TelemetryClientContext": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "version"],
        "additionalProperties": false,
        "title": "Telemetry Client Context",
        "description": "Identifies the client emitting telemetry, including its name and version."
      },
      "TelemetryContext": {
        "type": "object",
        "properties": {
          "client": {
            "$ref": "#/components/schemas/TelemetryClientContext"
          },
          "os": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              }
            },
            "required": ["name"],
            "additionalProperties": false,
            "title": "Operating System Context",
            "description": "Operating system metadata captured alongside telemetry."
          },
          "runtime": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name", "version"],
            "additionalProperties": false,
            "title": "Runtime Context",
            "description": "Language or process runtime metadata captured alongside telemetry."
          },
          "device": {
            "type": "object",
            "properties": {
              "arch": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["arch"],
            "additionalProperties": false,
            "title": "Device Context",
            "description": "Device characteristics attached to telemetry submissions."
          },
          "ide": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name", "version"],
            "additionalProperties": false,
            "title": "IDE Context",
            "description": "Editor or IDE metadata attached when telemetry originates from a development tool."
          },
          "environment": {
            "type": "string"
          },
          "ci": {
            "type": "boolean"
          },
          "invocationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "format": "uuid",
            "description": "Identity of the client process invocation that produced the batch; the same identity appears on that invocation's client error reports."
          }
        },
        "required": ["client"],
        "additionalProperties": false,
        "title": "Telemetry Context",
        "description": "Shared environment metadata attached to analytics event batches."
      },
      "TelemetryEventsRequest": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TelemetryEvent"
            }
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          },
          "context": {
            "$ref": "#/components/schemas/TelemetryContext"
          }
        },
        "required": ["events", "context"],
        "additionalProperties": false,
        "title": "Telemetry Events Request",
        "description": "Request payload accepted by the telemetry events ingestion endpoint."
      },
      "TelemetryPayloadTooLargeErrorEncoded": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["TelemetryPayloadTooLargeError"]
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": ["kind", "type", "title", "status", "detail", "code"],
        "additionalProperties": false
      },
      "TelemetryReportingClient": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Stable client identifier, for example `cli`."
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9A-Za-z.+-]+$",
            "description": "Released client version; development builds carry their build suffix here."
          },
          "runtime": {
            "type": "string",
            "enum": ["bun", "node"],
            "description": "JavaScript runtime executing the client."
          },
          "runtimeVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9A-Za-z.+-]+$",
            "description": "Version of the executing runtime, or `unknown`."
          },
          "platform": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Operating system platform identifier, for example `darwin`."
          },
          "architecture": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "CPU architecture identifier, for example `arm64`."
          },
          "ci": {
            "type": "boolean",
            "description": "Whether the client detected a continuous-integration host."
          }
        },
        "required": [
          "name",
          "version",
          "runtime",
          "runtimeVersion",
          "platform",
          "architecture",
          "ci"
        ],
        "additionalProperties": false,
        "title": "Telemetry Reporting Client",
        "description": "Bounded facts about the client build and host that reported a failure."
      },
      "TelemetryErrorReport": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "format": "uuid",
            "description": "Report identity, fresh per report and unchanged when the same report is resubmitted."
          },
          "invocationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "format": "uuid",
            "description": "Identity of the client process invocation that failed."
          },
          "occurredAt": {
            "$ref": "#/components/schemas/IsoDateTimeString"
          },
          "installationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "format": "uuid",
            "description": "Random persisted installation identity; absent when the client could not load or create it."
          },
          "activityId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "format": "uuid",
            "description": "Product activity correlation identity when the invocation started one."
          },
          "client": {
            "$ref": "#/components/schemas/TelemetryReportingClient"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9:_-]*( [a-z][a-z0-9:_-]*)*$",
            "description": "Canonical command identity when known, for example `extensions install`. Never arguments."
          },
          "phase": {
            "type": "string",
            "enum": ["bootstrap", "configuration", "command", "output"],
            "title": "Failure Phase",
            "description": "The invocation phase that settled with the failure: startup, workspace configuration, command execution, or output writing."
          },
          "failure": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
                "description": "Stable diagnostic identifier from the client's enumerated failure set."
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
                "description": "AXM error category, for example `validation` or `network`."
              },
              "class": {
                "type": "string",
                "enum": ["internal", "user", "external"],
                "title": "Error Class",
                "description": "Classifies whether a failure is an AXM defect, a user-correctable failure, or an external dependency failure."
              },
              "handled": {
                "type": "boolean",
                "description": "False when the failure is an unexpected defect rather than an expected error."
              }
            },
            "required": ["kind", "category", "class", "handled"],
            "additionalProperties": false,
            "title": "Reported Failure",
            "description": "Allowlisted diagnostic identity of one terminal failure."
          }
        },
        "required": ["eventId", "invocationId", "occurredAt", "client", "phase", "failure"],
        "additionalProperties": false,
        "title": "Telemetry Error Report",
        "description": "One bounded, allowlisted report of an opted-in client invocation's terminal failure. It carries no messages, stacks, arguments, paths, or other free-form content."
      },
      "TelemetryErrorReceipt": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "format": "uuid",
            "description": "Identity of the received report."
          },
          "receipt": {
            "type": "string",
            "enum": ["received"]
          }
        },
        "required": ["eventId", "receipt"],
        "additionalProperties": false,
        "title": "Telemetry Error Receipt",
        "description": "Synchronous receipt for a validated report. It is not durable acceptance, provider ingestion, or issue creation."
      }
    },
    "securitySchemes": {}
  },
