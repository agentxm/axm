{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli-e2e",
  "projectType": "application",
  "root": "packages/cli-e2e",
  "sourceRoot": "packages/cli-e2e/src",
  "tags": ["type:e2e", "scope:cli"],
  "targets": {
    "e2e-main": {
      "dependsOn": ["cli:build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "packages/cli-e2e"
      }
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["cli:compile"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/cli-e2e",
        "parallel": false,
        "commands": [
          "pnpm exec vitest run",
          "pnpm exec vitest run --config vitest.binary.config.ts",
          "pnpm exec vitest run --config vitest.install.config.ts"
        ]
      }
    },
    "binary-smoke": {
      "dependsOn": ["cli:compile"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.binary.config.ts",
        "cwd": "packages/cli-e2e"
      }
    },
    "binary-smoke-artifact": {
      "dependsOn": ["utils:build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.binary.config.ts",
        "cwd": "packages/cli-e2e"
      }
    },
    "install-verification": {
      "dependsOn": ["cli:compile"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.install.config.ts",
        "cwd": "packages/cli-e2e"
      }
    }
  }
}
