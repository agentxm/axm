{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "telemetry": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": ["errors"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "agents": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "adal",
              "amp",
              "antigravity",
              "augment",
              "claude-code",
              "cline",
              "codebuddy",
              "codex",
              "command-code",
              "continue",
              "crush",
              "cursor",
              "droid",
              "gemini-cli",
              "github-copilot",
              "goose",
              "iflow-cli",
              "junie",
              "kilo",
              "kimi-cli",
              "kiro-cli",
              "kode",
              "mcpjam",
              "mistral-vibe",
              "mux",
              "neovate",
              "openclaw",
              "opencode",
              "openhands",
              "pi",
              "pochi",
              "qoder",
              "qwen-code",
              "replit",
              "roo",
              "trae",
              "trae-cn",
              "windsurf",
              "zencoder"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^[a-z0-9][a-z0-9.-]*$"
                      }
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": ["github"]
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": ["name", "type", "url"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^[a-z0-9][a-z0-9.-]*$"
                      }
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": ["gitlab"]
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": ["name", "type", "url"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^[a-z0-9][a-z0-9.-]*$"
                      }
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": ["bitbucket"]
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": ["name", "type", "url"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^[a-z0-9][a-z0-9.-]*$"
                      }
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": ["azurerepos"]
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": ["name", "type", "url"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^[a-z0-9][a-z0-9.-]*$"
                      }
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": ["registry"]
                  },
                  "location": {
                    "type": "string"
                  }
                },
                "required": ["name", "type", "location"],
                "additionalProperties": false
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "commands": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "mcpServers": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "packs": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  }
                },
                "required": ["source"],
                "additionalProperties": false
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "skills": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "enabled": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["source"],
                "additionalProperties": false
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ignored": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "skills": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "commands": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "mcpServers": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "packs": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
