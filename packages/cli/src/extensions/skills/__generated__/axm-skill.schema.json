{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["namespace", "type", "name", "version"],
  "properties": {
    "namespace": {
      "type": "string",
      "description": "a string matching the pattern ^@[\\w-]+$",
      "pattern": "^@[\\w-]+$"
    },
    "type": {
      "type": "string",
      "enum": ["skill"]
    },
    "name": {
      "type": "string",
      "description": "a string matching the pattern ^[\\w-]+$",
      "pattern": "^[\\w-]+$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "bugs": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
