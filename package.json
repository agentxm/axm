{
  "name": "axm",
  "private": true,
  "type": "module",
  "scripts": {
    "axm": "nx run cli:start --no-tui",
    "axm:local": "nx run cli:start-local --no-tui",
    "spike": "nx run cli-spike:spike --no-tui",
    "build": "nx run-many -t build",
    "build:affected": "nx affected -t build",
    "test": "nx run-many -t test",
    "test:affected": "nx affected -t test",
    "test:e2e": "nx run-many -t e2e",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:affected": "nx affected -t typecheck",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "prepare": "husky && effect-language-service patch",
    "release:patch": "nx run axm:release"
  },
  "nx": {
    "includedScripts": []
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": "eslint --fix",
    "*.md": "prettier --write"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@types/bun": "catalog:",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.82.0",
    "@effect/vitest": "4.0.0-beta.37",
    "@eslint/js": "^9.18.0",
    "@nx/eslint": "22.6.1",
    "@nx/eslint-plugin": "22.6.1",
    "@nx/js": "22.6.1",
    "@nx/vitest": "22.6.1",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nx": "22.6.1",
    "prettier": "^3.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.21.0",
    "vite": "^7.3.1",
    "vitest": "catalog:"
  }
}
