{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gen-stack-inspection:v1alpha2",
  "title": "Gen Stack inspection envelope v1alpha2",
  "description": "Versioned read-only output for profile-governed Gen Stack corpus inspection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "snapshot",
    "discovery",
    "operation",
    "data",
    "diagnostics",
    "unknowns",
    "output_digest"
  ],
  "properties": {
    "schema_version": {"const": "gen-stack-inspection/v1alpha2"},
    "producer": {"$ref": "#/$defs/producer"},
    "snapshot": {"$ref": "#/$defs/snapshotIdentity"},
    "discovery": {"$ref": "#/$defs/discovery"},
    "operation": {
      "enum": [
        "status",
        "validate",
        "list",
        "show",
        "search",
        "evaluation-context",
        "evaluation-candidates",
        "snapshot",
        "diff",
        "path",
        "why",
        "affected-concepts"
      ]
    },
    "data": {},
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "unknowns": {
      "type": "array",
      "items": {"$ref": "#/$defs/unknown"}
    },
    "output_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "snapshot"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/snapshotData"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "evaluation-context"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/evaluationContext"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "evaluation-candidates"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/evaluationCandidates"}}}
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"const": "gen-stack-inspection"},
        "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "snapshotIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "snapshot_id", "corpus_digest"],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "version"],
          "properties": {
            "identity": {"const": "gen-stack"},
            "version": {"const": "0.5.0"}
          }
        },
        "snapshot_id": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "corpus_digest": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "okf_result", "structural_result", "semantic_result"],
      "properties": {
        "state": {"enum": ["absent", "unsupported", "invalid", "conforming"]},
        "okf_result": {"enum": ["pass", "fail", "unknown"]},
        "structural_result": {"enum": ["pass", "fail"]},
        "semantic_result": {"enum": ["pass", "fail", "unknown"]}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "path",
        "location",
        "message",
        "blocking",
        "recovery"
      ],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "error"]},
        "path": {"type": "string"},
        "location": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["line", "column"],
              "properties": {
                "line": {"type": "integer", "minimum": 1},
                "column": {"type": "integer", "minimum": 1}
              }
            }
          ]
        },
        "message": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "recovery": {"type": ["string", "null"]}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "reason"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "pattern": "^gen-stack/"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "conceptSummary": {
      "type": "object",
      "required": ["ref", "type", "title", "description", "status"],
      "properties": {
        "ref": {"type": "string", "pattern": "^/"},
        "type": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "stable", "deprecated"]},
        "requirement_id": {"type": "string", "minLength": 1},
        "requirement_type": {
          "enum": ["functional", "quality", "process", "human-factors", "usability", "constraint"]
        },
        "requirement_lifecycle": {"enum": ["active", "retired"]},
        "subject": {"type": "string", "pattern": "^/"},
        "protocol_id": {"type": "string", "minLength": 1},
        "protocol_lifecycle": {"enum": ["active", "retired"]},
        "evaluation_role": {
          "enum": ["requirement-satisfaction", "architecture-realization", "implementation-conformance"]
        },
        "targets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "concept": {
      "allOf": [
        {"$ref": "#/$defs/conceptSummary"},
        {
          "type": "object",
          "required": ["attributes", "source", "available_views", "body", "sections"],
          "properties": {
            "attributes": {"type": "object"},
            "source": {"$ref": "#/$defs/source"},
            "available_views": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "body": {"type": "string"},
            "sections": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            }
          }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "relationship",
        "from",
        "to",
        "forward_role",
        "inverse_role",
        "assertion_source",
        "assertion",
        "derivation"
      ],
      "properties": {
        "ref": {"type": "string", "pattern": "^edge:[0-9a-f]{16}$"},
        "relationship": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "forward_role": {"type": "string", "minLength": 1},
        "inverse_role": {"type": "string", "minLength": 1},
        "assertion_source": {"type": "string", "minLength": 1},
        "assertion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field"],
          "properties": {
            "kind": {"enum": ["asserted", "derived"]},
            "field": {"type": "string", "minLength": 1}
          }
        },
        "derivation": {"enum": ["asserted", "derived"]}
      }
    },
    "hierarchyNode": {
      "allOf": [
        {"$ref": "#/$defs/conceptSummary"},
        {
          "type": "object",
          "required": ["direct_requirements", "children"],
          "properties": {
            "direct_requirements": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "children": {
              "type": "array",
              "items": {"$ref": "#/$defs/hierarchyNode"}
            }
          }
        }
      ]
    },
    "snapshotData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concepts", "relationships"],
      "properties": {
        "concepts": {
          "type": "array",
          "items": {"$ref": "#/$defs/concept"}
        },
        "relationships": {
          "type": "array",
          "items": {"$ref": "#/$defs/relationship"}
        }
      }
    },
    "evaluationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "surfaces",
        "structure",
        "ancestor_context",
        "related_subjects",
        "requirements",
        "cross_view_mappings",
        "c4_views",
        "governance",
        "interpretation"
      ],
      "properties": {
        "scope": {"type": "object"},
        "surfaces": {
          "type": "array",
          "items": {"$ref": "#/$defs/hierarchyNode"}
        },
        "structure": {
          "type": "array",
          "items": {"$ref": "#/$defs/hierarchyNode"}
        },
        "ancestor_context": {"type": "array", "items": {"type": "object"}},
        "related_subjects": {
          "type": "array",
          "items": {"$ref": "#/$defs/conceptSummary"}
        },
        "requirements": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "cross_view_mappings": {
          "type": "array",
          "items": {"$ref": "#/$defs/relationship"}
        },
        "c4_views": {"type": "array", "items": {"type": "object"}},
        "governance": {"type": "object"},
        "interpretation": {
          "type": "object",
          "required": [
            "requirement_association",
            "requirement_inheritance",
            "suite_layout",
            "c4_views_are_evaluation_subjects",
            "coverage_claim"
          ]
        }
      }
    },
    "protocolMatches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "retired"],
      "properties": {
        "active": {
          "type": "array",
          "items": {"$ref": "#/$defs/conceptSummary"}
        },
        "retired": {
          "type": "array",
          "items": {"$ref": "#/$defs/conceptSummary"}
        }
      }
    },
    "implementationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "type"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "type": {"const": "Implementation Unit"}
      }
    },
    "evaluationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "protocol_target",
        "target",
        "subject",
        "basis",
        "scope_relation",
        "matching_protocols"
      ],
      "properties": {
        "role": {
          "enum": ["requirement-satisfaction", "architecture-realization", "implementation-conformance"]
        },
        "protocol_target": {"type": "string", "minLength": 1},
        "target": {
          "oneOf": [
            {"$ref": "#/$defs/conceptSummary"},
            {"$ref": "#/$defs/implementationTarget"}
          ]
        },
        "subject": {
          "oneOf": [
            {"$ref": "#/$defs/conceptSummary"},
            {"type": "null"}
          ]
        },
        "basis": {
          "enum": [
            "active-direct-requirement",
            "eligible-architecture-authority",
            "active-protocol-declared-implementation-unit"
          ]
        },
        "scope_relation": {
          "enum": ["complete-corpus", "primary", "descendant", "cross-view"]
        },
        "matching_protocols": {"$ref": "#/$defs/protocolMatches"}
      }
    },
    "evaluationCandidateExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "target", "reason", "scope_relation"],
      "properties": {
        "role": {
          "enum": ["requirement-satisfaction", "architecture-realization"]
        },
        "target": {"$ref": "#/$defs/conceptSummary"},
        "reason": {
          "enum": ["retired-requirement", "c4-view-is-projection"]
        },
        "scope_relation": {
          "enum": ["complete-corpus", "primary", "descendant", "cross-view", "context"]
        }
      }
    },
    "evaluationCandidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "candidates",
        "excluded",
        "ancestor_context",
        "interpretation"
      ],
      "properties": {
        "scope": {"type": "object"},
        "candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/evaluationCandidate"}
        },
        "excluded": {
          "type": "array",
          "items": {"$ref": "#/$defs/evaluationCandidateExclusion"}
        },
        "ancestor_context": {
          "type": "array",
          "items": {"$ref": "#/$defs/conceptSummary"}
        },
        "interpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_meaning",
            "selection_claim",
            "coverage_claim",
            "protocol_adequacy_claim",
            "requirement_association",
            "requirement_inheritance",
            "implementation_discovery"
          ],
          "properties": {
            "candidate_meaning": {"const": "eligible role-and-target pair for consideration"},
            "selection_claim": {"const": "not-assessed"},
            "coverage_claim": {"const": "not-assessed"},
            "protocol_adequacy_claim": {"const": "not-assessed"},
            "requirement_association": {"const": "direct-only"},
            "requirement_inheritance": {"const": "not-inferred"},
            "implementation_discovery": {"const": "active-protocol-targets-only"}
          }
        }
      }
    }
  }
}
