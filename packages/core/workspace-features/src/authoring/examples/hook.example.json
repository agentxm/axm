{
  "$schema": "https://axm.sh/schemas/hook.schema.json",
  "type": "hook",
  "owner": "@acme",
  "name": "tool-audit",
  "version": "0.1.0",
  "description": "Blocks writes that look like secrets.",
  "capabilities": {
    "network": false,
    "filesystemWrite": false,
    "exec": [],
    "env": []
  },
  "implementations": [
    {
      "id": "claude",
      "protocol": "claude-code",
      "bindings": [
        {
          "id": "protect-secrets",
          "event": "PreToolUse",
          "matcher": "Write|Edit",
          "requires": {
            "outcomes": ["deny"]
          },
          "handler": {
            "type": "command",
            "runtime": "bash",
            "entrypoint": "src/hook.sh",
            "timeoutMs": 5000
          }
        }
      ]
    }
  ]
}
