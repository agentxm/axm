{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Why Renovate rather than Dependabot: nearly every version in this
  // repository is declared in the `catalog:` block of `pnpm-workspace.yaml`.
  // Dependabot's npm ecosystem does not resolve pnpm catalogs, so it would
  // manage the handful of direct manifest entries and leave the real version
  // surface untouched. Renovate resolves catalogs natively.
  // Decision, comparison, and hosting: devops/tools/renovate.md
  extends: ["config:recommended", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],

  timezone: "Etc/UTC",
  schedule: ["before 6am on monday"],
  labels: ["dependencies"],
  semanticCommits: "disabled",

  // This repository squashes pull requests and requires the Actions-owned
  // `Required CI` result through the merge queue. Renovate branches are
  // ordinary pull requests, so they run the same gate as authored work; no
  // bypass path exists or is configured.
  automerge: false,

  // A manager that opens more pull requests than anyone reviews is a net loss.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // `pnpm-workspace.yaml` sets `minimumReleaseAge: 1440` (minutes). Renovate
  // honours the same one-day window so a proposal is never opened for a release
  // the installer would then refuse.
  minimumReleaseAge: "1 day",
  internalChecksFilter: "strict",

  // Catalog entries are ranges (`^8.2.0`). The default `replace` strategy only
  // acts once a release leaves the range, which would leave the catalog drifting
  // within its carets — the exact drift this configuration exists to stop.
  // `bump` raises the declared range to each new release.
  rangeStrategy: "bump",
  postUpdateOptions: ["pnpmDedupe"],

  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on the first day of the month"],
  },

  // Advisories are the one class that should not wait out the stability window.
  // Paired with the repository's own audit gate rather than replacing it.
  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: null,
    schedule: ["at any time"],
    labels: ["dependencies", "security"],
  },
  osvVulnerabilityAlerts: true,

  packageRules: [
    {
      // Route majors to the dependency dashboard so each one is visible and
      // chosen deliberately, rather than opening branches that conflict with a
      // migration already in flight. Revisit once the tracked majors land.
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // This cohort is pinned to one exact release candidate (`4.0.0-rc.115`)
      // across `effect` and the `@effect/*` packages, and
      // `minimumReleaseAgeExclude` names those pins individually. The cohort
      // only moves as a whole, under its own migration, because adopting one
      // member against the others produces a type and runtime mismatch that no
      // review of a single-package proposal would catch.
      groupName: "Effect",
      matchPackageNames: ["effect", "@effect/**"],
      enabled: false,
    },
    {
      // The declared types currently sit two majors ahead of the Node runtime
      // pinned in `mise.toml`, which arrived by drift rather than by decision.
      // Resolving the direction is a separate decision with its own authority,
      // because `engines` in the published CLI manifest is a user-facing
      // contract. Hold the entry until that decision lands, then replace this
      // rule with a ceiling tied to the chosen runtime major.
      matchPackageNames: ["@types/node"],
      enabled: false,
    },
    {
      // `engines.node` is a published contract: every manifest here declares
      // `>=22.19.0`, and raising it can refuse installation for an end user.
      // A dry run showed Renovate proposing `>=22.23.2` as an ordinary minor
      // across ten manifests, which is below the major gate and would have
      // landed that decision automatically. The runtime floor moves under its
      // own decision, in the same change as the development pin.
      matchDepTypes: ["engines"],
      enabled: false,
    },
    {
      // The development toolchain is declared twice on purpose — `mise.toml`
      // owns the Node, pnpm, and Bun pins, and `package.json` repeats the pnpm
      // version in `packageManager` — and `check:ci-toolchain` fails the build
      // unless the two agree. Renovate reaches them through different managers
      // and therefore different branches, so a dry run produced four competing
      // pnpm proposals, each of which breaks that check on its own. Move the
      // toolchain by hand, in one change that updates both declarations.
      matchManagers: ["mise"],
      enabled: false,
    },
    {
      matchDepTypes: ["packageManager"],
      enabled: false,
    },
    {
      // The Windows release-verification jobs cannot use the workspace setup
      // action, so `publish.yml` repeats the mise Node and Bun pins literally
      // and `check:ci-toolchain` asserts the copies still match. Renovate reads
      // them as ordinary action inputs and proposed Bun 1.3.14 -> 1.4.2 there
      // while `mise.toml` stayed put, which fails that assertion. These copies
      // follow the toolchain; they do not lead it.
      matchManagers: ["github-actions"],
      matchPackageNames: ["node", "bun"],
      enabled: false,
    },
    {
      // The `overrides:` block pins transitive security floors: each key is the
      // vulnerable range and its value is the lowest safe release. Renovate
      // treats the value as an ordinary dependency and proposed bumps that do
      // not track any advisory — including `brace-expansion@>=1.0.0 <1.1.18`
      // to `5.0.12`, a version the key's own range excludes. Advisories reach
      // this repository through `vulnerabilityAlerts` and its audit gate; the
      // floors stay a manual authority.
      matchDepTypes: ["pnpm-workspace.overrides"],
      enabled: false,
    },
    {
      groupName: "Nx",
      matchPackageNames: ["nx", "@nx/**"],
    },
    {
      groupName: "Vite and Vitest",
      matchPackageNames: ["vite", "@vitejs/**", "vitest", "@vitest/**"],
    },
    {
      // ESLint, its own scope, the shared parser cohort, and every plugin move
      // as one change. A plugin that lags ESLint's major turns a single-package
      // proposal into a peer conflict, so the group keeps the conflict visible
      // in one branch instead of spreading it across several.
      groupName: "ESLint",
      matchPackageNames: [
        "eslint",
        "@eslint/**",
        "eslint-config-*",
        "eslint-import-resolver-*",
        "eslint-plugin-*",
        "typescript-eslint",
        "@typescript-eslint/**",
        "jsonc-eslint-parser",
      ],
    },
    {
      // The two TypeScript aliases are deliberate architecture, not drift:
      // `@typescript/native` is the TypeScript 7 compiler and `typescript` is
      // the TypeScript 6 compatibility package. They are raised together, and
      // collapsing them is governed by the dual-alias decision record.
      groupName: "TypeScript",
      matchPackageNames: ["typescript", "@typescript/**"],
    },
    {
      // Allure's runtime, its commons library, and its Vitest integration are
      // published from one release line and read each other's report format.
      groupName: "Allure",
      matchPackageNames: ["allure", "allure-js-commons", "allure-vitest"],
    },
    {
      groupName: "GitHub Actions",
      matchManagers: ["github-actions"],
      // Workflow digests are low-risk and high-churn; the weekly cadence that
      // the retired Dependabot configuration ran is preserved here.
      minimumReleaseAge: "3 days",
    },
  ],
}
