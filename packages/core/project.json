{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "core",
  "projectType": "library",
  "root": "packages/core",
  "sourceRoot": "packages/core/src",
  "tags": ["type:lib", "scope:core"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{ts,tsx,js,mjs,cjs}"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "packages/core/vitest.config.ts"
      }
    },
    "generate-registry-client": {
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/generate-registry-client.ts"],
        "cwd": "packages/core"
      }
    },
    "generate-telemetry-client": {
      "executor": "nx:run-commands",
      "options": {
        "command": ["bun", "scripts/generate-telemetry-client.ts"],
        "cwd": "packages/core"
      }
    },
    "publish": {
      "cache": false,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm publish --provenance --access public --no-git-checks",
        "cwd": "packages/core"
      }
    }
  }
}
