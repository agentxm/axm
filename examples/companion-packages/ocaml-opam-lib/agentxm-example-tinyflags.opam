opam-version: "2.0"
name: "agentxm-example-tinyflags"
version: "0.1.0"
synopsis: "Tiny feature-flag library used by AXM companion package examples."
description: """
A minimal feature flag library demonstrating how an opam package can ship
companion AXM extensions for its users. Supports boolean flags with optional
percentage rollouts, variant flags with allowed values and rollout
allocations, and deterministic context bucketing so a given context id
receives stable rollout decisions.
"""
maintainer: "AgentXM <noreply@agentxm.ai>"
authors: ["AgentXM"]
license: "MIT"
homepage: "https://github.com/agentxm/axm-b"
bug-reports: "https://github.com/agentxm/axm-b/issues"
dev-repo: "git+https://github.com/agentxm/axm-b.git"
tags: ["feature-flags" "tinyflags" "axm"]

depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "alcotest" {with-test & >= "1.7.0"}
]

build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]

# AXM companion-extension recommendations. The AXM opam reader parses any
# field beginning with `x-axm-` and decodes it against AxmPackageMetaSchema.
# The recommendedExtensions field points to the companion pack so that
# downstream consumers see the bundle when `axm discover` runs.
x-axm-recommendedExtensions: ["@examples/packs/ocaml-opam-tinyflags@^0.1.0"]
