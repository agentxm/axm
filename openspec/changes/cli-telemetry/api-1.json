          "telemetry"
        ],
        "operationId": "getTelemetryPing",
        "summary": "Ping telemetry service",
        "description": "Lightweight health check endpoint for connectivity checks.",
        "responses": {
          "200": {
            "description": "Telemetry service is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "service": {
                      "type": "string",
                      "enum": [
                        "telemetry"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "service"
                  ]
                }
              }
            }
          }
        }
      }
    },
