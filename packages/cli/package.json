{
  "name": "axm.sh",
  "version": "0.22.3",
  "description": "Extension manager for AI coding agents — install skills, subagents, slash commands, and MCP servers across Claude Code, Codex, Cursor, Copilot, and more.",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "homepage": "https://axm.sh",
  "bugs": {
    "url": "https://github.com/agentxm/axm/issues"
  },
  "author": "AgentXM <hello@agentxm.ai> (https://agentxm.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentxm/axm.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "agent",
    "agents",
    "ai-agent",
    "agent-extensions",
    "agent-skills",
    "extensions",
    "extension-manager",
    "cli",
    "anthropic",
    "mcp",
    "mcp-server",
    "skill",
    "skills",
    "subagent",
    "subagents",
    "slash-commands",
    "pack",
    "claude-code",
    "github-copilot-cli",
    "cursor",
    "gemini-cli",
    "codex",
    "opencode",
    "windsurf",
    "cline",
    "goose",
    "qwen-code"
  ],
  "bin": {
    "axm": "./dist/src/main.js"
  },
  "exports": {
    "./app": {
      "types": "./dist/src/app.d.ts",
      "default": "./dist/src/app.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "default": "./dist/src/runtime.js"
    }
  },
  "files": [
    "dist/src/",
    "!dist/src/test-helpers.*",
    "!dist/src/test-stubs.*",
    "!**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "includedScripts": []
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@agentxm/client-core": "workspace:^",
    "@agentxm/client-utils": "workspace:^",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "gray-matter": "catalog:",
    "semver": "catalog:",
    "simple-git": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/semver": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
